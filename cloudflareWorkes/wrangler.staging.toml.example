name = "cookby-appointment-staging"
main = "worker.js"
compatibility_date = "2026-08-17"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[[d1_databases]]
binding = "DB"
database_name = "cookby_appointment_staging"
database_id = "REPLACE_WITH_STAGING_D1_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "FILE_BUCKET"
bucket_name = "cookby-appointment-staging"

[vars]
FAMILY_MODE = "on"
DEFAULT_TIMEZONE = "Asia/Shanghai"
FAMILY_MEMBER_LIMIT = "20"
INVITE_TTL_HOURS = "72"
MAX_UPLOAD_BYTES = "5242880"
FAMILY_STORAGE_QUOTA_BYTES = "209715200"
MINIPROGRAM_VERSION = "1.0.1-staging"
MINIPROGRAM_MIN_VERSION = "1.0.1"

[observability]
enabled = true
head_sampling_rate = 1
