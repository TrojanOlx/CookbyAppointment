page {
  height: 100vh;
  overflow: hidden;
}

.preferences-page {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.preferences-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
  overflow-x: hidden;
}

.page-heading {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 4rpx 6rpx 24rpx;
}

.heading-ribbon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 54rpx;
  padding: 8rpx 30rpx;
  color: #fff9e8;
  background: var(--primary-color);
  border-radius: 16rpx;
  box-shadow: 0 6rpx 0 var(--primary-dark);
  font-size: 34rpx;
  font-weight: 900;
}

.heading-subtitle {
  flex: 1;
  min-width: 180rpx;
  padding-top: 14rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.notice-card,
.preference-card {
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle, rgba(248,166,178,0.10) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    radial-gradient(circle, rgba(255,255,255,0.22) 1.5rpx, transparent 2.5rpx) 12rpx 12rpx/28rpx 28rpx,
    #fff9e8;
  border: 4rpx solid rgba(121, 79, 39, 0.16);
  border-radius: var(--radius-lg);
  box-shadow: 0 7rpx 0 rgba(121, 79, 39, 0.1), 0 14rpx 24rpx rgba(61, 52, 40, 0.12);
}

.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
  background:
    radial-gradient(circle, rgba(247,205,103,0.15) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    #fff5d5;
  border-color: rgba(219, 169, 14, 0.3);
}

.notice-icon {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  border-radius: 50%;
  color: #fff9e8;
  background: var(--warning-color);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
}

.notice-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.notice-title {
  color: var(--text-color);
  font-size: 27rpx;
  font-weight: 900;
}

.notice-body {
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
}

.preference-card {
  padding: 28rpx 26rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-heading {
  margin-bottom: 22rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.section-title {
  color: var(--text-color);
  font-size: 31rpx;
  font-weight: 900;
}

.section-eyebrow {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: 21rpx;
  font-weight: 800;
}

.tone-coral {
  color: #a0443d;
  background: #ffd8d1;
}

.tone-orange {
  color: #9a5a24;
  background: #ffe1bd;
}

.tone-teal {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.tone-yellow {
  color: #8b6900;
  background: #ffefbd;
}

.section-hint {
  color: var(--text-light);
  font-size: 23rpx;
  line-height: 1.5;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  color: var(--text-secondary);
  background: #fffdf4;
  border: 3rpx solid var(--border-color);
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 700;
  transition: transform var(--motion-press) var(--ease-out);
}

.tag:active {
  transform: translateY(2rpx) scale(0.97);
}

.tag-selected {
  color: #fff9e8;
  background: var(--primary-color);
  border-color: var(--primary-color);
  box-shadow: 0 4rpx 0 var(--primary-dark);
}

.tag-custom {
  border-style: dashed;
}

.tag-mark {
  flex-shrink: 0;
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.custom-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  color: var(--text-color);
  background: var(--input-bg);
  border: 3rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
}

.custom-placeholder {
  color: var(--text-light);
}

.add-tag-button {
  width: 112rpx;
  height: 74rpx;
  margin: 0;
  padding: 0;
  color: var(--text-color);
  background: var(--accent-yellow);
  border: 0;
  border-radius: var(--radius-sm);
  box-shadow: 0 5rpx 0 #dba90e;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 74rpx;
  transition: transform var(--motion-press) var(--ease-out);
}

.button-pressed,
.add-tag-button:active {
  transform: translateY(2rpx) scale(0.97);
  box-shadow: 0 2rpx 0 #dba90e;
}

.spicy-card {
  padding-bottom: 28rpx;
}

.spicy-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.spicy-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 108rpx;
  padding: 12rpx 8rpx;
  color: var(--text-secondary);
  background: #fffdf4;
  border: 3rpx solid var(--border-color);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  transition: transform var(--motion-press) var(--ease-out);
}

.spicy-option:active {
  transform: translateY(2rpx) scale(0.97);
}

.spicy-option.spicy-selected {
  color: var(--text-color);
  background: #ffefbd;
  border-color: var(--accent-yellow);
  box-shadow: 0 4rpx 0 #dba90e;
}

.spicy-dot {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid var(--border-strong);
  border-radius: 50%;
  box-sizing: border-box;
}

.spicy-selected .spicy-dot {
  border: 7rpx solid var(--accent-orange);
  background: #fff9e8;
}

.current-spicy {
  margin-top: 18rpx;
  color: var(--text-light);
  font-size: 23rpx;
  text-align: center;
}

.save-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  margin: 0 24rpx;
  max-width: calc(100% - 48rpx);
  padding: 18rpx 24rpx 14rpx;
  background: #fff9e8;
  border: 4rpx solid rgba(121,79,39,0.18);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
  box-shadow: 0 8rpx 0 rgba(121,79,39,0.12), 0 16rpx 30rpx rgba(61,52,40,0.14);
}

.save-button {
  width: 100%;
  height: 88rpx;
  margin: 0;
  box-sizing: border-box;
  color: var(--text-color);
  background: var(--card-bg-light);
  border: 4rpx solid #fff7d6;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-fab);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 80rpx;
  transition: transform var(--motion-press) var(--ease-out);
}

.save-button:active {
  transform: translateY(2rpx) scale(0.97);
}

.save-button[disabled] {
  opacity: 0.72;
}

.save-hint {
  margin-top: 14rpx;
  color: var(--text-light);
  font-size: 22rpx;
}

.loading-state {
  padding: 8rpx 0 28rpx;
  color: var(--text-light);
  font-size: 23rpx;
  text-align: center;
}

.load-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  color: #a0443d;
  background: var(--danger-light);
  border: 2rpx solid rgba(224,90,90,0.24);
  border-radius: var(--radius-md);
  font-size: 23rpx;
  line-height: 1.45;
}

.load-error text {
  min-width: 0;
  flex: 1;
}

.load-error button {
  flex-shrink: 0;
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  color: var(--danger-color);
  background: #fff9e8;
  border: 0;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
  transition: transform var(--motion-press) var(--ease-out);
}

.load-error button::after { border: 0; }

.load-error button:active {
  transform: translateY(2rpx) scale(0.97);
}

/* ── 固定操作栏，与菜品编辑页保持一致 ── */
.bottom-safe-area {
  height: calc(204rpx + env(safe-area-inset-bottom));
}

.preferences-bottom-fixed {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}

.bottom-action-dock {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  height: calc(210rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(255,249,232,0) 0%,
    rgba(255,249,232,0.96) 18%,
    #fff9e8 42%,
    #fff9e8 100%
  );
  border-radius: 44rpx 44rpx 0 0;
  box-shadow: 0 -18rpx 38rpx rgba(61,52,40,0.10);
}

.preferences-bottom-fixed .safe-area-bottom {
  height: env(safe-area-inset-bottom);
  background: transparent;
}

@media (max-width: 360px) {
  .spicy-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (prefers-reduced-motion: reduce) {
  .tag,
  .add-tag-button,
  .spicy-option,
  .save-button,
  .load-error button {
    transition: none;
  }

  .tag:active,
  .add-tag-button:active,
  .spicy-option:active,
  .save-button:active,
  .load-error button:active,
  .button-pressed {
    transform: none;
  }
}
