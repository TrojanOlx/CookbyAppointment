<view class="preferences-page">
  <view class="fixed-page-bg"></view>
  <scroll-view class="preferences-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="page-heading">
      <view class="heading-ribbon">口味偏好</view>
      <text class="heading-subtitle">让每一餐都更合心意</text>
    </view>

    <view class="notice-card">
      <view class="notice-icon">!</view>
      <view class="notice-copy">
        <text class="notice-title">只做备菜提醒，不会拦住预约</text>
        <text class="notice-body">过敏信息很重要，下单前仍请再确认一次食材和做法。</text>
      </view>
    </view>

    <view class="preference-card" wx:for="{{categories}}" wx:for-item="category" wx:for-index="categoryIndex" wx:key="key">
      <view class="section-heading">
        <view class="section-title-row">
          <text class="section-title">{{category.title}}</text>
          <text class="section-eyebrow tone-{{category.tone}}">{{category.eyebrow}}</text>
        </view>
        <text class="section-hint">{{category.hint}}</text>
      </view>

      <view class="tag-grid">
        <view
          wx:for="{{category.tags}}"
          wx:for-item="tag"
          wx:for-index="tagIndex"
          wx:key="label"
          class="tag {{tag.selected ? 'tag-selected' : ''}} {{tag.custom ? 'tag-custom' : ''}}"
          bindtap="toggleTag"
          data-category-index="{{categoryIndex}}"
          data-tag-index="{{tagIndex}}"
        >
          <text>{{tag.label}}</text>
          <text class="tag-mark" wx:if="{{tag.selected}}">✓</text>
        </view>
      </view>

      <view class="custom-row">
        <input
          class="custom-input"
          value="{{category.customInput}}"
          maxlength="20"
          placeholder="{{category.placeholder}}"
          placeholder-class="custom-placeholder"
          data-category-index="{{categoryIndex}}"
          bindinput="onCustomInput"
          confirm-type="done"
          bindconfirm="addCustomTag"
        />
        <button class="add-tag-button" hover-class="button-pressed" bindtap="addCustomTag" data-category-index="{{categoryIndex}}">添加</button>
      </view>
    </view>

    <view class="preference-card spicy-card">
      <view class="section-heading">
        <view class="section-title-row">
          <text class="section-title">辣度</text>
          <text class="section-eyebrow tone-yellow">偏好选择</text>
        </view>
        <text class="section-hint">告诉家人你今天想吃多辣，未设置也可以正常预约。</text>
      </view>
      <view class="spicy-grid">
        <view
          wx:for="{{spicyLevels}}"
          wx:for-item="level"
          wx:key="value"
          class="spicy-option {{spicyLevel === level.value ? 'spicy-selected' : ''}}"
          bindtap="selectSpicy"
          data-value="{{level.value}}"
        >
          <text class="spicy-dot"></text>
          <text>{{level.label}}</text>
        </view>
      </view>
      <view class="current-spicy">当前：{{spicyLabel}}</view>
    </view>

    <view class="loading-state" wx:if="{{loading}}">正在读取偏好...</view>

    <!-- 为固定操作栏预留滚动空间，避免末尾内容被遮挡 -->
    <view class="bottom-safe-area"></view>
  </scroll-view>

  <view class="bottom-fixed-area">
    <view class="bottom-action-dock"></view>
    <view class="save-area">
      <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="savePreferences">保存偏好</button>
      <text class="save-hint" wx:if="{{dirty}}">有未保存的选择</text>
      <text class="save-hint" wx:else>偏好会随当前家庭保存</text>
    </view>
    <view class="safe-area-bottom"></view>
  </view>
</view>
