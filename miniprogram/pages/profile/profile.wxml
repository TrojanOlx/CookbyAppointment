<!-- 我的页面 -->
<view class="profile-page">
  <view class="fixed-page-bg"></view>
  <scroll-view
    class="profile-container"
    scroll-y="true"
    scroll-into-view="{{scrollIntoView}}"
    enhanced="true"
    show-scrollbar="false"
  >
  <!-- 用户信息区 -->
  <view id="profile-info" class="user-info">
    <block wx:if="{{!userInfo}}">
      <button class="login-btn" bindtap="doLogin" loading="{{isLoggingIn}}" disabled="{{isLoggingIn}}">微信登录</button>
    </block>
    <view wx:elif="{{userInfo}}" class="user-avatar-info">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image referrerPolicy="no-referrer" class="avatar" src="{{userInfo.avatarUrl}}"></image>
      </button>
      <view class="user-info-text">
        <block wx:if="{{editingNickName}}">
          <input
            type="nickname"
            class="nickname-input"
            placeholder="请输入昵称"
            value="{{editingNickNameValue}}"
            maxlength="20"
            cursor-spacing="24"
            confirm-type="done"
            focus="true"
            bind:input="onNickNameInput"
            bind:blur="onNickNameConfirm"
            bind:confirm="onNickNameConfirm"
          />
        </block>
        <block wx:else>
          <view class="user-name" bindtap="onNickNameEdit">{{userInfo.nickName || '点击设置昵称'}}</view>
        </block>
      </view>
    </view>
  </view>
  <view wx:if="{{userInfo && (!userInfo.avatarUrl || !userInfo.nickName || userInfo.nickName === '微信用户' || userInfo.nickName === '微信昵称' || userInfo.nickName === '用户')}}" class="user-tip">
    请点击头像和昵称进行完善
  </view>
  
  <!-- 功能菜单 -->
  <view class="menu-list">
    <view class="menu-section" wx:if="{{userInfo}}">
      <view class="menu-title">家庭</view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/family/index/index">
        <image class="menu-icon-img" src="/images/icons/icon-home.svg" mode="aspectFit"></image>
        <text class="menu-text">{{currentFamilyName || '创建或加入家庭'}}{{currentFamilyRole ? ' · ' + (currentFamilyRole === 'owner' ? '家庭主' : currentFamilyRole === 'admin' ? '管理员' : currentFamilyRole === 'chef' ? '厨师' : '成员') : ''}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/preferences/preferences">
        <image class="menu-icon-img" src="/images/island/icon-settings.svg" mode="aspectFit"></image>
        <text class="menu-text">口味与忌口</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
    <view wx:if="{{userInfo && !familyLoading && !hasFamily && !familySelectionRequired}}" class="family-empty-card">
      <view class="family-empty-title">还没有家庭</view>
      <view class="family-empty-subtitle">创建一个家庭，或扫码加入家人的邀请</view>
      <view class="family-empty-actions">
        <button class="family-action-btn family-action-create" bindtap="openCreateFamily">创建家庭</button>
        <button class="family-action-btn family-action-join" bindtap="openJoinFamily">加入家庭</button>
      </view>
    </view>
    <view wx:elif="{{userInfo && !familyLoading && familySelectionRequired}}" class="family-empty-card">
      <view class="family-empty-title">请选择家庭</view>
      <view class="family-empty-subtitle">你加入了多个家庭，请先选择当前要使用的家庭。</view>
      <view class="family-empty-actions">
        <button class="family-action-btn family-action-create" bindtap="navigateTo" data-url="/pages/family/index/index">选择家庭</button>
      </view>
    </view>
    <view class="menu-section">
      <view class="menu-title">用户功能</view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/appointment/appointment">
        <image class="menu-icon-img" src="/images/island/icon-appointment.svg" mode="aspectFit"></image>
        <text class="menu-text">我的预约</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/reviews/reviews">
        <image class="menu-icon-img" src="/images/island/icon-review.svg" mode="aspectFit"></image>
        <text class="menu-text">我的评价</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/inventory/inventory">
        <image class="menu-icon-img" src="/images/island/icon-basket.svg" mode="aspectFit"></image>
        <text class="menu-text">家庭冰箱</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 家庭管理 -->
    <view class="menu-section" wx:if="{{isAdmin || canManageFamily}}">
      <view class="menu-title">家庭管理</view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/menu/menu">
        <image class="menu-icon-img" src="/images/island/icon-dish.svg" mode="aspectFit"></image>
        <text class="menu-text">编辑菜单</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/admin/appointments/appointments">
        <image class="menu-icon-img" src="/images/island/icon-admin.svg" mode="aspectFit"></image>
        <text class="menu-text">查看预约</text>
        <text class="menu-arrow">></text>
      </view>
      <view wx:if="{{isAdmin}}" class="menu-item" bindtap="navigateTo" data-url="/pages/profile/admin/reviews/reviews">
        <image class="menu-icon-img" src="/images/island/icon-review.svg" mode="aspectFit"></image>
        <text class="menu-text">查看评价</text>
        <text class="menu-arrow">></text>
      </view>
      <view wx:if="{{isAdmin}}" class="menu-item" bindtap="navigateTo" data-url="/pages/profile/admin/statistics/statistics">
        <image class="menu-icon-img" src="/images/island/icon-stats.svg" mode="aspectFit"></image>
        <text class="menu-text">预约统计</text>
        <text class="menu-arrow">></text>
      </view>
      <view wx:if="{{isAdmin}}" class="menu-item" bindtap="navigateTo" data-url="/pages/profile/admin/files/files">
        <image class="menu-icon-img" src="/images/island/icon-file.svg" mode="aspectFit"></image>
        <text class="menu-text">文件管理</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="menu-section" wx:if="{{isPlatformAdmin}}">
      <view class="menu-title">平台维护</view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/platform-admin/index/index">
        <image class="menu-icon-img" src="/images/island/icon-stats.svg" mode="aspectFit"></image>
        <text class="menu-text">平台管理</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 设置选项 -->
  <view class="settings">
    <view class="menu-item" bindtap="clearCache">
      <image class="menu-icon-img" src="/images/island/icon-delete.svg" mode="aspectFit"></image>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/settings/settings">
      <image class="menu-icon-img" src="/images/island/icon-settings.svg" mode="aspectFit"></image>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">></text>
    </view>
    <!-- 退出登录按钮 -->
    <view class="menu-item" bindtap="doLogout" wx:if="{{userInfo}}">
      <image class="menu-icon-img" src="/images/island/icon-logout.svg" mode="aspectFit"></image>
      <text class="menu-text">退出登录</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 版本号 -->
  <view class="profile-version">版本 {{version}}</view>
  </scroll-view>
</view>
