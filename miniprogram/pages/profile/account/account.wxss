.account-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx 56rpx;
  background: #f7f3df;
}

.section {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: #fffdf3;
  border: 2rpx solid rgba(121, 79, 39, 0.18);
  border-radius: 12rpx;
}

.section-title {
  color: #3d3428;
  font-size: 32rpx;
  font-weight: 700;
}

.section-copy {
  margin: 16rpx 0 26rpx;
  color: #746856;
  font-size: 26rpx;
  line-height: 1.65;
}

.primary-action,
.danger-action {
  margin: 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.primary-action {
  color: #ffffff;
  background: #0f8f85;
}

.danger-section {
  border-color: rgba(201, 73, 60, 0.32);
}

.danger-action {
  color: #c9493c;
  background: #fff4f1;
  border: 2rpx solid rgba(201, 73, 60, 0.35);
}

.status {
  margin-top: 18rpx;
  color: #746856;
  font-size: 24rpx;
  word-break: break-all;
}
