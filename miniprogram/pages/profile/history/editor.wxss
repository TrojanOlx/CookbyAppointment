page {
  height: 100vh;
  overflow: hidden;
}

button::after { border: 0; }

.history-editor-page {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
  color: var(--text-color);
}

.history-editor-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: 26rpx 24rpx 0;
  overflow-x: hidden;
}

.editor-heading { margin: 0 6rpx 20rpx; }

.editor-kicker {
  display: inline-block;
  box-sizing: border-box;
  padding: 5rpx 16rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 2rpx solid rgba(25,200,185,0.28);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 900;
}

.editor-title {
  margin-top: 12rpx;
  color: var(--text-color);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.25;
}

.editor-subtitle {
  margin-top: 7rpx;
  color: var(--text-light);
  font-size: 24rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.editor-error {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 14rpx 16rpx;
  color: var(--danger-color);
  background: var(--danger-light);
  border: 2rpx solid rgba(224,90,90,0.18);
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  line-height: 1.5;
}

.editor-error image { width: 30rpx; height: 30rpx; flex-shrink: 0; margin: 2rpx 10rpx 0 0; }
.editor-error text { min-width: 0; overflow-wrap: anywhere; }

.editor-state-card {
  box-sizing: border-box;
  min-height: 360rpx;
  padding: 28rpx;
  background: var(--card-bg-light);
  border: 3rpx solid rgba(121,79,39,0.14);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.editor-section {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 18rpx;
  padding: 22rpx 20rpx;
  background:
    radial-gradient(circle, rgba(248,166,178,0.08) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    #fff9e8;
  border: 3rpx solid rgba(121,79,39,0.15);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.editor-section-title {
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  color: var(--text-color);
  background: var(--accent-yellow);
  border-radius: 15rpx;
  box-shadow: 0 4rpx 0 #dba90e;
  font-size: 26rpx;
  font-weight: 900;
}

.editor-section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-width: 0;
  gap: 12rpx;
}

.editor-section-hint,
.editor-section-caption {
  color: var(--text-light);
  font-size: 21rpx;
}

.editor-section-hint { flex-shrink: 0; }

.editor-section-caption {
  margin-top: 12rpx;
  line-height: 1.45;
}

.editor-field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  box-sizing: border-box;
  border-bottom: 2rpx solid rgba(159,146,125,0.20);
}

.editor-field-row:last-child { border-bottom: 0; }

.editor-field-label { color: var(--text-secondary); font-size: 26rpx; font-weight: 800; }

.editor-picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 230rpx;
  min-height: 68rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 2rpx solid rgba(25,200,185,0.22);
  border-radius: var(--radius-full);
  font-size: 25rpx;
  font-weight: 900;
}

.editor-picker-value text { margin-left: 10rpx; color: var(--text-light); font-size: 25rpx; }

.editor-scope-list { margin-top: 14rpx; }

.editor-scope-option {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 100rpx;
  padding: 10rpx 8rpx;
  box-sizing: border-box;
  border-bottom: 2rpx solid rgba(159,146,125,0.20);
  transition: transform var(--motion-press) var(--ease-out);
}

.editor-scope-option:last-child { border-bottom: 0; }
.editor-scope-option:active { transform: translateY(2rpx); }
.editor-scope-option.is-disabled { opacity: 0.52; }

.editor-scope-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  margin-right: 14rpx;
  color: #fff9e8;
  background: var(--input-bg);
  border: 3rpx solid var(--border-color);
  border-radius: 50%;
  font-size: 27rpx;
  font-weight: 900;
}

.editor-scope-option.is-active .editor-scope-mark { background: var(--primary-color); border-color: var(--primary-color); box-shadow: 0 3rpx 0 var(--primary-dark); }

.editor-scope-copy { min-width: 0; flex: 1; }

.editor-scope-title { display: block; color: var(--text-color); font-size: 26rpx; font-weight: 900; }

.editor-scope-hint {
  display: block;
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--text-light);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editor-inline-loading { margin-top: 10rpx; }

.editor-dish-hint {
  margin-top: 12rpx;
  color: var(--text-light);
  font-size: 22rpx;
  line-height: 1.5;
}

.dish-option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.dish-option {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 112rpx;
  box-sizing: border-box;
  gap: 10rpx;
  padding: 10rpx;
  background: var(--input-bg);
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  transition: transform var(--motion-press) var(--ease-out), background var(--motion-state) ease;
}

.dish-option:active { transform: translateY(2rpx); }
.dish-option.is-selected { background: var(--primary-light); border-color: var(--primary-color); box-shadow: 0 4rpx 0 rgba(15,143,133,0.14); }

.dish-option-image { width: 70rpx; height: 70rpx; flex: 0 0 70rpx; background: var(--card-bg-light); border-radius: 12rpx; }
.dish-option-copy { min-width: 0; flex: 1; }
.dish-option-name { display: block; overflow: hidden; color: var(--text-color); font-size: 23rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.dish-option-type { display: block; margin-top: 4rpx; color: var(--text-light); font-size: 19rpx; }

.dish-option-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  color: #fff9e8;
  background: transparent;
  border: 2rpx solid var(--border-color);
  border-radius: 50%;
  font-size: 21rpx;
  font-weight: 900;
}

.dish-option.is-selected .dish-option-check { background: var(--primary-color); border-color: var(--primary-color); }

.editor-custom-label { margin-top: 20rpx; color: var(--text-secondary); font-size: 24rpx; font-weight: 800; }

.editor-dish-textarea,
.editor-note-textarea {
  width: 100%;
  min-height: 132rpx;
  box-sizing: border-box;
  margin-top: 10rpx;
  padding: 14rpx;
  color: var(--text-color);
  background: var(--input-bg);
  border: 2rpx solid rgba(121,79,39,0.16);
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.editor-note-textarea { min-height: 190rpx; }
.editor-placeholder { color: var(--text-light); }

.editor-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.editor-image-wrap,
.editor-image-add {
  width: 154rpx;
  height: 154rpx;
  box-sizing: border-box;
}

.editor-image-wrap { position: relative; }
.editor-image { width: 100%; height: 100%; border-radius: 16rpx; }

.editor-image-remove {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  color: #fff;
  background: rgba(61,52,40,0.70);
  border-radius: 0 16rpx 0 14rpx;
  font-size: 29rpx;
  line-height: 1;
}

.editor-image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: var(--primary-dark);
  background: var(--input-bg);
  border: 2rpx dashed rgba(25,200,185,0.44);
  border-radius: 16rpx;
  font-size: 21rpx;
  line-height: 1.3;
}

.editor-image-add image { width: 46rpx; height: 46rpx; margin-bottom: 7rpx; }

.editor-delete-button {
  min-height: 88rpx;
  width: 100%;
  box-sizing: border-box;
  margin: 2rpx 0 18rpx;
  color: var(--danger-color);
  background: var(--danger-light);
  border: 3rpx solid rgba(224,90,90,0.20);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.editor-bottom-spacer { height: calc(170rpx + env(safe-area-inset-bottom)); }

.editor-bottom-fixed {
  position: relative;
  z-index: 5;
  flex-shrink: 0;
  box-sizing: border-box;
  background: rgba(247,243,223,0.96);
  box-shadow: 0 -8rpx 24rpx rgba(61,52,40,0.10);
}

.editor-bottom-dock { height: 8rpx; background: var(--primary-color); opacity: 0.75; }

.editor-actions { display: flex; gap: 14rpx; padding: 14rpx 24rpx 12rpx; }

.editor-cancel-button,
.editor-save-button {
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  border-radius: var(--radius-full);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.editor-cancel-button { flex: 0 0 180rpx; color: var(--text-secondary); background: transparent; border: 3rpx solid var(--border-color); }
.editor-save-button { flex: 1; color: #fff9e8; background: var(--primary-color); box-shadow: 0 5rpx 0 var(--primary-dark); }
.editor-safe-area { height: env(safe-area-inset-bottom); min-height: 0; }

@media (prefers-reduced-motion: reduce) {
  .editor-scope-option,
  .dish-option {
    transition: none;
  }
}
