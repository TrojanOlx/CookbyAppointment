page {
  height: 100vh;
  overflow: hidden;
}

button::after { border: 0; }

.history-page {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
  color: var(--text-color);
}

.history-header {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 28rpx 28rpx 18rpx;
  background:
    radial-gradient(circle, rgba(247,205,103,0.12) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    rgba(247,243,223,0.98);
  border-bottom: 2rpx solid rgba(121,79,39,0.12);
  border-radius: 0 0 34rpx 34rpx;
  box-shadow: 0 8rpx 20rpx rgba(61,52,40,0.08);
}

.history-heading-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-width: 0;
  gap: 18rpx;
}

.history-heading { min-width: 0; flex: 1; }

.history-kicker {
  display: inline-block;
  box-sizing: border-box;
  padding: 5rpx 16rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 2rpx solid rgba(25,200,185,0.28);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 900;
}

.history-title {
  margin-top: 12rpx;
  color: var(--text-color);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.24;
}

.history-subtitle {
  max-width: 100%;
  margin-top: 7rpx;
  color: var(--text-light);
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.history-add-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 9rpx 4rpx 6rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 3rpx solid rgba(25,200,185,0.32);
  border-radius: 24rpx;
  box-shadow: 0 5rpx 0 rgba(15,143,133,0.16);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.1;
  transition: transform var(--motion-press) var(--ease-out);
}

.history-add-button image {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 3rpx;
}

.history-add-button:active,
.history-search-button:active,
.history-clear-button:active,
.history-retry-button:active,
.history-repeat-button:active {
  transform: translateY(2rpx) scale(0.97);
}

.scope-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.scope-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  color: var(--text-secondary);
  background: var(--input-bg);
  border: 3rpx solid var(--border-color);
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 900;
  white-space: nowrap;
  transition: transform var(--motion-press) var(--ease-out), background var(--motion-state) ease;
}

.scope-tab:active { transform: translateY(2rpx) scale(0.98); }

.scope-tab.is-active {
  color: #fff9e8;
  background: var(--primary-color);
  border-color: var(--primary-color);
  box-shadow: 0 5rpx 0 var(--primary-dark);
}

.history-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: 22rpx 24rpx 0;
  overflow-x: hidden;
}

.history-tools {
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx 18rpx 16rpx;
  background:
    radial-gradient(circle, rgba(248,166,178,0.09) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    var(--card-bg-light);
  border: 3rpx solid rgba(121,79,39,0.14);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.history-search {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 12rpx 0 18rpx;
  background: var(--input-bg);
  border: 3rpx solid rgba(121,79,39,0.18);
  border-radius: 22rpx;
}

.history-search-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.history-search-input {
  min-width: 0;
  flex: 1;
  height: 82rpx;
  color: var(--text-color);
  font-size: 27rpx;
  line-height: 82rpx;
}

.history-search-placeholder { color: var(--text-light); }

.history-search-button,
.history-clear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 0;
  border-radius: 18rpx;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
  transition: transform var(--motion-press) var(--ease-out);
}

.history-search-button image { width: 30rpx; height: 30rpx; }

.filter-row {
  display: flex;
  gap: 10rpx;
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.filter-row picker { min-width: 0; flex: 1; }

.filter-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 12rpx;
  color: var(--text-secondary);
  background: #fffdf4;
  border: 2rpx solid var(--border-color);
  border-radius: 18rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.filter-picker.is-selected {
  color: var(--primary-dark);
  background: var(--primary-light);
  border-color: rgba(25,200,185,0.42);
}

.filter-picker-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-picker-arrow {
  flex-shrink: 0;
  margin-left: 4rpx;
  color: var(--text-light);
  font-size: 25rpx;
}

.history-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 16rpx;
  margin: 24rpx 6rpx 16rpx;
}

.history-summary-copy {
  display: flex;
  align-items: baseline;
  min-width: 0;
  gap: 14rpx;
}

.history-summary-title {
  min-width: 0;
  overflow: hidden;
  color: var(--text-color);
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-summary-count,
.history-summary-caption {
  flex-shrink: 0;
  color: var(--text-light);
  font-size: 22rpx;
  white-space: nowrap;
}

.history-summary-caption {
  padding: 5rpx 12rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border-radius: var(--radius-full);
}

.history-state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  box-sizing: border-box;
  padding: 30rpx;
  text-align: center;
  background:
    radial-gradient(circle, rgba(248,166,178,0.09) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    var(--card-bg-light);
  border: 3rpx solid rgba(121,79,39,0.14);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.history-state-icon {
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: var(--danger-light);
  border-radius: 50%;
}

.history-empty-icon { padding: 0; background: transparent; }

.history-state-title {
  color: var(--text-color);
  font-size: 30rpx;
  font-weight: 900;
}

.history-state-copy {
  max-width: 590rpx;
  margin-top: 8rpx;
  color: var(--text-light);
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.history-retry-button {
  min-height: 88rpx;
  margin: 22rpx 0 0;
  padding: 0 30rpx;
  color: #fff9e8;
  background: var(--primary-color);
  border-radius: var(--radius-full);
  box-shadow: 0 5rpx 0 var(--primary-dark);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 88rpx;
  transition: transform var(--motion-press) var(--ease-out);
}

.history-empty-action { color: var(--text-color); background: var(--accent-yellow); box-shadow: 0 5rpx 0 #dba90e; }

.history-inline-loading,
.history-inline-error {
  margin-bottom: 12rpx;
}

.history-inline-error {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  box-sizing: border-box;
  padding: 10rpx 16rpx;
  color: var(--danger-color);
  background: var(--danger-light);
  border-radius: var(--radius-sm);
  font-size: 23rpx;
}

.history-inline-error text { min-width: 0; flex: 1; overflow-wrap: anywhere; }

.history-inline-error button {
  flex-shrink: 0;
  min-height: 58rpx;
  margin: 0 0 0 12rpx;
  padding: 0 16rpx;
  color: var(--danger-color);
  background: transparent;
  border: 2rpx solid rgba(224,90,90,0.30);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  line-height: 54rpx;
}

.history-month { margin-bottom: 18rpx; }

.history-month-title {
  display: inline-flex;
  min-height: 54rpx;
  align-items: center;
  box-sizing: border-box;
  margin: 0 0 12rpx 6rpx;
  padding: 0 20rpx;
  color: var(--text-color);
  background: var(--accent-yellow);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 0 #dba90e;
  font-size: 25rpx;
  font-weight: 900;
}

.history-timeline-item {
  display: flex;
  align-items: stretch;
  min-width: 0;
  margin-bottom: 16rpx;
}

.history-date-rail {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 108rpx;
  width: 108rpx;
  padding-top: 18rpx;
  box-sizing: border-box;
}

.history-date-day {
  color: var(--text-color);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
}

.history-date-weekday {
  margin-top: 6rpx;
  color: var(--text-light);
  font-size: 21rpx;
  line-height: 1.2;
}

.history-date-rail::after {
  content: '';
  position: absolute;
  top: 92rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  background: var(--primary-color);
  border: 4rpx solid var(--card-bg-light);
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(15,143,133,0.24);
  z-index: 1;
}

.history-date-line {
  position: absolute;
  top: 104rpx;
  bottom: -28rpx;
  left: 50%;
  width: 3rpx;
  transform: translateX(-50%);
  background: rgba(25,200,185,0.26);
}

.history-timeline-item:last-child .history-date-line { bottom: 20rpx; }

.history-memory-card {
  min-width: 0;
  flex: 1;
  box-sizing: border-box;
  padding: 20rpx;
  background:
    radial-gradient(circle, rgba(248,166,178,0.08) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    #fff9e8;
  border: 3rpx solid rgba(121,79,39,0.15);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: transform var(--motion-press) var(--ease-out);
}

.history-memory-card:active { transform: translateY(2rpx); }

.history-memory-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 12rpx;
}

.history-memory-meta {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 10rpx;
}

.history-meal-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 48rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  color: var(--text-color);
  background: var(--accent-yellow);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 900;
}

.history-source-label,
.history-family-label {
  min-width: 0;
  overflow: hidden;
  color: var(--text-light);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-family-label {
  flex-shrink: 1;
  max-width: 42%;
  color: var(--text-secondary);
  text-align: right;
}

.history-memory-main {
  display: flex;
  min-width: 0;
  gap: 16rpx;
  margin-top: 16rpx;
}

.history-memory-image {
  width: 128rpx;
  height: 128rpx;
  flex: 0 0 128rpx;
  background: var(--input-bg);
  border-radius: 18rpx;
}

.history-memory-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.history-dish-names {
  display: -webkit-box;
  overflow: hidden;
  color: var(--text-color);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.history-memory-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.history-memory-footer {
  display: flex;
  gap: 14rpx;
  margin-top: auto;
  padding-top: 8rpx;
  color: var(--text-light);
  font-size: 20rpx;
  white-space: nowrap;
}

.history-memory-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 70rpx;
  gap: 14rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 2rpx solid rgba(159,146,125,0.20);
}

.history-repeat-button {
  min-height: 66rpx;
  margin: 0 auto 0 0;
  padding: 0 20rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 2rpx solid rgba(25,200,185,0.24);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 62rpx;
  transition: transform var(--motion-press) var(--ease-out);
}

.history-open-hint {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  color: var(--text-light);
  font-size: 22rpx;
  white-space: nowrap;
}

.history-open-icon {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 24rpx;
  opacity: 0.72;
}

.history-list-footer {
  padding: 16rpx 0 34rpx;
  text-align: center;
}

.history-list-end {
  color: var(--text-light);
  font-size: 22rpx;
}

.history-bottom-spacer { height: calc(48rpx + env(safe-area-inset-bottom)); }

@media (prefers-reduced-motion: reduce) {
  .history-add-button,
  .scope-tab,
  .history-retry-button,
  .history-repeat-button,
  .history-memory-card,
  .history-search-button,
  .history-clear-button {
    transition: none;
  }
}
