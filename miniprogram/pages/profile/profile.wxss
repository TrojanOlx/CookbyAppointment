/* 页面容器 */
page {
  height: 100vh;
  overflow: hidden;
}

.profile-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.profile-container {
  position: relative;
  z-index: 1;
  height: 100%;
  min-height: 0;
  padding: 24rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); /* 为TabBar留出足够空间 */
  background: transparent;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 用户信息区域 */
.user-info {
  background: linear-gradient(145deg, var(--primary-light) 0%, var(--card-bg) 100%);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: var(--shadow-md);
}

.login-btn {
  width: 70%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-full);
  margin: 20rpx 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-fab);
}

.login-options-btn {
  width: 45%;
  height: 88rpx;
  line-height: 88rpx;
  background: #2196F3;
  color: #fff;
  border-radius: var(--radius-full);
  margin: 20rpx 10rpx;
  font-size: 30rpx;
}

.get-info-btn {
  font-size: 26rpx;
  color: #2196F3;
  padding: 10rpx 0;
  margin-top: 10rpx;
  text-decoration: underline;
}

.userinfo-btn {
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  background: #2196F3;
  color: #fff;
  border-radius: var(--radius-full);
  margin: 20rpx auto;
  font-size: 30rpx;
}

.user-avatar-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
  border: 4rpx solid var(--primary-color);
  box-shadow: var(--shadow-sm);
}

.user-info-text {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  color: var(--text-color);
  font-weight: 700;
}

.user-openid {
  font-size: 24rpx;
  color: var(--text-light);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

/* 菜单列表 */
.menu-list {
  background: transparent;
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
}

.menu-section {
  margin-bottom: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.menu-title {
  font-size: 28rpx;
  color: var(--text-light);
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
  background: var(--input-bg);
  font-weight: 600;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: background 0.15s;
}

.menu-item:active {
  background: var(--input-bg);
}

.menu-icon {
  margin-right: 20rpx;
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-color);
  font-weight: 500;
}

.menu-arrow {
  color: var(--border-color);
  font-size: 28rpx;
  font-weight: 300;
  letter-spacing: -2rpx;
}

/* 设置区域 */
.settings {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  margin-bottom: 30rpx; /* 增加底部间距 */
  overflow: hidden;
}

/* 管理员菜单样式 */
.menu-section:last-child .menu-item:last-child {
  border-bottom: none;
}

/* 退出登录按钮样式 */
.settings .menu-item:last-child .menu-text {
  color: var(--danger-color);
}

.avatar-btn {
  display: flex;
  align-items: center;
  padding: 0;
  background: transparent;
  border: none;
  margin-right: 30rpx;
}

.profile-version {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 40rpx;
  padding-bottom: 20rpx;
}

/* Animal Island native redesign */
.profile-container {
  background: transparent;
}

.user-info {
  min-height: 180rpx;
  justify-content: flex-start;
  background:
    radial-gradient(circle, rgba(247,205,103,0.20) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    var(--card-bg);
  border: 2rpx solid rgba(159,146,125,0.36);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.user-info::before {
  content: '';
  width: 12rpx;
  height: 128rpx;
  margin-right: 24rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(180deg, var(--primary-color), var(--accent-yellow), var(--accent-coral));
}

.login-btn {
  color: var(--text-color);
  background: var(--card-bg-light);
  border: 4rpx solid #fff7d6;
  box-shadow: var(--shadow-fab);
  font-weight: 900;
}

.avatar {
  border: 6rpx solid var(--card-bg-light);
  box-shadow: 0 0 0 4rpx var(--primary-color), var(--shadow-sm);
}

.user-name {
  font-size: 38rpx;
  font-weight: 900;
}

.user-tip {
  margin: -4rpx 8rpx 20rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  text-align: center;
}

.menu-section,
.settings {
  background: #fff9e8;
  border: 4rpx solid rgba(121,79,39,0.16);
  border-radius: var(--radius-lg);
  box-shadow: 0 7rpx 0 rgba(121,79,39,0.10), 0 14rpx 24rpx rgba(61,52,40,0.12);
}

.menu-title {
  display: inline-flex;
  margin: 22rpx 0 6rpx 24rpx;
  padding: 6rpx 24rpx;
  color: #fff9e8;
  background: var(--primary-color);
  border: 0;
  border-radius: 14rpx;
  box-shadow: 0 5rpx 0 var(--primary-dark);
}

.menu-item {
  padding: 26rpx 30rpx;
  border-bottom-color: rgba(159,146,125,0.28);
}

.menu-icon-img {
  width: 52rpx;
  height: 52rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-text {
  color: var(--text-color);
  font-weight: 800;
}

.menu-arrow {
  color: var(--text-muted);
  font-weight: 800;
  letter-spacing: 0;
}

.login-options-btn,
.userinfo-btn {
  background: var(--accent-blue);
}

.get-info-btn {
  color: #5068d8;
}
