.appointments-container { display: none; }

page {
  height: 100vh;
  overflow: hidden;
  background: var(--background-color);
}

/* ── 主容器 ── */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--background-color);
}

/* ── 日历区域 ── */
.calendar-section {
  background: var(--card-bg);
  padding: 16rpx 20rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 16rpx;
}

/* ── 预约列表区域 ── */
.appointments-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  padding-left: 20rpx;
  position: relative;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

.appointments-list {
  flex: 1;
  overflow-y: auto;
  width: 100%;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.appointments-list::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

/* ── 加载状态 ── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 20rpx;
}
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #E8E8E8;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-text { font-size: 26rpx; color: var(--text-light); }
@keyframes spin { to { transform: rotate(360deg); } }

/* ── 用户卡片 ── */
.user-card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid var(--border-color);
}

.user-header {
  padding: 22rpx 28rpx;
  background: var(--primary-light);
  border-bottom: 1rpx solid rgba(76,175,80,0.18);
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: opacity 0.15s;
}
.user-header:active { opacity: 0.8; }

.expand-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  transition: transform var(--motion-state) var(--ease-out);
}
.expand-icon.expanded { transform: rotate(180deg); }
.expand-icon .iconfont { font-size: 24rpx; color: var(--primary-dark); }

.user-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-dark);
  padding-left: 18rpx;
  position: relative;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-name::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 28rpx;
  width: 6rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

/* ── 餐次列表 ── */
.meals-list {
  width: 100%;
  box-sizing: border-box;
  background: var(--card-bg);
  overflow: hidden;
  padding: 16rpx 28rpx;
  opacity: 0;
  transform: translateY(-6rpx);
  transition: transform var(--motion-state) var(--ease-out), opacity var(--motion-state) ease-out;
}
.meals-list.expanded {
  opacity: 1;
  transform: translateY(0);
}
.meals-list.collapsed {
  opacity: 0;
  transform: translateY(-6rpx);
}

.meal-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.meal-item:last-child { border-bottom: none; }

.meal-type-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 10rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--input-bg);
  border-left: 4rpx solid var(--primary-color);
}
.meal-item:nth-child(3n+2) .meal-type-wrapper { border-left-color: #FF9800; }
.meal-item:nth-child(3n+3) .meal-type-wrapper { border-left-color: #9C27B0; }

.meal-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
}

.meal-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
  display: inline-block;
  vertical-align: middle;
}

.dish-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0;
}

.dish-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--input-bg);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid var(--border-color);
}

/* ── 状态 badge ── */
.meal-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}
.status-pending { color: var(--warning-color); background: var(--warning-light); border: 1rpx solid rgba(255,152,0,0.25); }
.status-confirmed { color: #2196F3; background: rgba(33,150,243,0.1); border: 1rpx solid rgba(33,150,243,0.25); }
.status-completed { color: var(--primary-dark); background: var(--primary-light); border: 1rpx solid rgba(76,175,80,0.25); }
.status-cancelled { color: var(--danger-color); background: var(--danger-light); border: 1rpx solid rgba(244,67,54,0.25); }

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}
.empty-text { font-size: 28rpx; color: var(--text-light); text-align: center; }

/* ── 操作按钮 ── */
.action-buttons {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.action-btn {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 500;
  transition: opacity 0.15s;
}
.action-btn:active { opacity: 0.75; }

.confirm-btn { background: rgba(33,150,243,0.12); color: #2196F3; border: 1rpx solid rgba(33,150,243,0.25); }
.complete-btn { background: var(--primary-light); color: var(--primary-dark); border: 1rpx solid rgba(76,175,80,0.25); }
.cancel-btn { background: var(--danger-light); color: var(--danger-color); border: 1rpx solid rgba(244,67,54,0.25); }
.review-btn { background: #FFF8E1; color: #E65100; border: 1rpx solid rgba(230,81,0,0.2); }
.reactivate-btn { background: #ECEFF1; color: #546E7A; border: 1rpx solid rgba(84,110,122,0.25); }

/* Animal Island native redesign */
.container {
  background: transparent;
}

.calendar-section,
.user-card {
  border: 4rpx solid rgba(121,79,39,0.18);
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 0 rgba(121,79,39,0.12), 0 16rpx 30rpx rgba(61,52,40,0.14);
}

.calendar-section {
  width: auto;
  margin: 18rpx 24rpx 18rpx;
  padding: 14rpx;
  box-sizing: border-box;
  background: #fff9e8;
  overflow: hidden;
}

.calendar-section calendar {
  display: block;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background: #fff9e8;
  border-radius: 30rpx;
}

.section-title {
  display: inline-flex;
  padding: 6rpx 24rpx;
  color: #fff9e8;
  background: var(--primary-color);
  border-radius: 14rpx;
  box-shadow: 0 5rpx 0 var(--primary-dark);
}

.section-title::before,
.user-name::before {
  display: none;
}

.user-header {
  background: #fff9e8;
}

.meal-icon-img {
  width: 38rpx;
  height: 38rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  vertical-align: middle;
}

.meal-type {
  display: flex;
  align-items: center;
}

.meal-type-wrapper,
.dish-name {
  border-color: rgba(159,146,125,0.30);
}

.action-btn {
  font-weight: 800;
}

.meal-item:nth-child(3n+2) .meal-type-wrapper {
  border-left-color: var(--accent-yellow);
}

.meal-item:nth-child(3n+3) .meal-type-wrapper {
  border-left-color: var(--accent-blue);
}

.status-confirmed,
.confirm-btn {
  color: #5068d8;
  background: rgba(136,157,240,0.18);
  border-color: rgba(136,157,240,0.32);
}

.status-completed,
.complete-btn {
  color: #4f8b1e;
  background: var(--success-light);
  border-color: rgba(138,198,138,0.36);
}

.review-btn {
  color: var(--text-color);
  background: var(--accent-yellow);
  border-color: #dba90e;
}

/* ── 完成预约的库存预览 ── */
.completion-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(40rpx + env(safe-area-inset-top)) 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(61, 52, 40, 0.42);
  opacity: 0;
  pointer-events: none;
  transition: opacity 160ms ease-out;
}

.completion-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.completion-modal {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 80rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 30rpx 28rpx 24rpx;
  background: #fff9e8;
  border: 4rpx solid rgba(121,79,39,0.18);
  border-radius: var(--radius-lg);
  box-shadow: 0 10rpx 0 rgba(121,79,39,0.14), 0 20rpx 42rpx rgba(61,52,40,0.24);
  opacity: 0;
  transform: scale(0.96);
  transition: transform 140ms var(--ease-in-out), opacity 140ms ease-in;
}

.completion-modal.active {
  opacity: 1;
  transform: scale(1);
  transition-duration: 200ms;
  transition-timing-function: var(--ease-out), ease-out;
}

.completion-close {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx !important;
  min-width: 80rpx !important;
  height: 80rpx !important;
  min-height: 80rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  line-height: 80rpx;
  background: rgba(121,79,39,0.08);
  border: 0;
  border-radius: 50%;
}

.completion-close::after { border: 0; }
.completion-close mp-icon { display: block; }
.completion-close[disabled] { opacity: 0.5; }

.completion-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding-right: 84rpx;
}

.completion-modal-header > view:first-child {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.completion-modal-title {
  color: var(--text-color);
  font-size: 34rpx;
  font-weight: 900;
}

.completion-modal-subtitle {
  margin-top: 6rpx;
  color: var(--text-light);
  font-size: 23rpx;
}

.completion-alert {
  flex-shrink: 0;
  padding: 5rpx 16rpx;
  color: #8b6900;
  background: #ffefbd;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 900;
}

.completion-preview-scroll {
  flex: 1;
  min-height: 120rpx;
  height: 52vh;
  max-height: 52vh;
  padding: 2rpx 4rpx;
  box-sizing: border-box;
}

.preview-section {
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fffdf4;
  border: 3rpx solid rgba(159,146,125,0.28);
  border-radius: var(--radius-md);
}

.preview-section:last-child { margin-bottom: 0; }

.preview-section-title {
  margin-bottom: 12rpx;
  color: var(--text-color);
  font-size: 26rpx;
  font-weight: 900;
}

.deduction-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 54rpx;
  border-bottom: 1rpx solid rgba(159,146,125,0.2);
}

.deduction-row:last-child { border-bottom: none; }

.deduction-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deduction-quantity {
  flex-shrink: 0;
  color: var(--danger-color);
  font-size: 25rpx;
  font-weight: 800;
}

.preview-empty {
  color: var(--text-light);
  font-size: 24rpx;
}

.preview-warning {
  background: #fff5d5;
  border-color: rgba(219,169,14,0.28);
}

.unresolved-row {
  display: block;
  padding: 6rpx 0;
  color: #8b6900;
  font-size: 24rpx;
  line-height: 1.5;
}

.unresolved-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--text-light);
  font-size: 22rpx;
  line-height: 1.45;
}

.completion-modal-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 24rpx;
}

.completion-modal-actions button {
  flex: 1;
  height: 78rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 70rpx;
}

.completion-cancel {
  color: var(--text-secondary);
  background: transparent;
  border: 3rpx dashed var(--border-color);
}

.completion-confirm {
  color: var(--text-color);
  background: var(--accent-yellow);
  border: 3rpx solid #fff1b5;
  box-shadow: 0 5rpx 0 #dba90e;
}

.completion-modal-actions button[disabled] { opacity: 0.66; }

@media (prefers-reduced-motion: reduce) {
  .loading-spinner { animation: none; }

  .expand-icon,
  .meals-list,
  .completion-overlay,
  .completion-modal {
    transition-duration: 1ms;
  }

  .meals-list,
  .meals-list.expanded,
  .meals-list.collapsed,
  .completion-modal,
  .completion-modal.active {
    transform: none;
  }
}
