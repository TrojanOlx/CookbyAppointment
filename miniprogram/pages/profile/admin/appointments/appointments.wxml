<view class="container" style="padding-bottom: {{safeAreaBottom ? (safeAreaBottom + 48 + 'px') : '120rpx'}};">
  <!-- 日历部分 -->
  <view class="calendar-section">
    <calendar 
      id="calendar"
      view="week"
      mode="{{calendarMode}}"
      style="width:100%;--wc-primary:#19c8b9;--wc-primary-2:rgba(25,200,185,0.18);--wc-bg-light:#fff9e8;--wc-title-color-light:#794f27;--wc-title-sub-color-light:#725d42;--wc-op-bg-light:#e6f9f6;--wc-op-color-light:#0f8f85;--wc-week-color-light:#8a7b66;--wc-date-color-light:#794f27;--wc-mark-color-light:#9f927d;--wc-dot-color-light:#f7cd67;--wc-schedule-color-light:#0f8f85;--wc-schedule-bg-light:#e6f9f6;--wc-today-color-light:#0f8f85;--wc-solar-color-light:#e59266;--wc-checked-color-light:#794f27;--wc-checked-mark-color-light:#794f27;--wc-checked-dot-color-light:#794f27;--wc-checked-today-color-light:#fff9e8;--wc-checked-bg-light:#f7cd67;--wc-checked-today-bg-light:#19c8b9;--wc-control-bg-light:#c4b89e;--wc-panel-height:600rpx;--wc-title-size:42rpx;--wc-date-size:34rpx;"
      date="{{selectedDate}}"
      marks="{{markedDates}}"
      lunar="{{true}}"
      plugins="{{plugins}}"
      header="{{true}}"
      fold="{{false}}"
      bindload="onCalendarLoad"
      bindclick="onCalendarSelect"
      bindchange="onCalendarChange"
      bindviewchange="onViewChange"
    />
  </view>

  <!-- 预约列表部分 -->
  <view class="appointments-section">
    <view class="section-header">
      <text class="section-title">{{selectedDateDisplay}}用户预约</text>
    </view>

    <view class="appointments-list">
      <!-- 加载状态 -->
      <view class="loading-state" wx:if="{{isLoading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      
      <!-- 预约列表 -->
      <block wx:elif="{{userAppointments.length > 0}}">
        <view class="user-card" wx:for="{{userAppointments}}" wx:key="userName" wx:for-item="user" wx:for-index="userIndex">
          <view class="user-header" bindtap="toggleUserExpand" data-index="{{userIndex}}">
            <text class="user-name">{{user.userName}}</text>
            <view class="expand-icon {{user.isExpanded ? 'expanded' : ''}}">
              <text class="iconfont">{{user.isExpanded ? '▼' : '▶'}}</text>
            </view>
          </view>
          <view class="meals-list {{user.isExpanded ? 'expanded' : 'collapsed'}}">
            <view class="meal-item" wx:for="{{user.meals}}" wx:key="type" wx:for-item="meal">
              <view class="meal-type-wrapper">
                <view class="meal-type">
                  <image class="meal-icon-img" wx:if="{{meal.type === '早餐'}}" src="/images/island/icon-sunrise.svg" mode="aspectFit"></image>
                  <image class="meal-icon-img" wx:elif="{{meal.type === '午餐'}}" src="/images/island/icon-sun.svg" mode="aspectFit"></image>
                  <image class="meal-icon-img" wx:elif="{{meal.type === '晚餐'}}" src="/images/island/icon-moon.svg" mode="aspectFit"></image>
                  {{meal.type}}
                </view>
                <view class="meal-status status-{{meal.status === '待确认' ? 'pending' : meal.status === '已确认' ? 'confirmed' : meal.status === '已完成' ? 'completed' : 'cancelled'}}">{{meal.status || '待确认'}}</view>
              </view>
              <view class="dish-list">
                <text class="dish-name" wx:for="{{meal.dishes}}" wx:key="*this" wx:for-item="dish">{{dish}}</text>
              </view>
              
              <!-- 根据状态显示不同按钮 -->
              <view class="action-buttons" wx:if="{{canManageAppointments && meal.status !== '已取消'}}">
                <!-- 待确认状态按钮 -->
                <block wx:if="{{meal.status === '待确认'}}">
                  <view class="action-btn confirm-btn" bindtap="confirmAppointment" data-appointment-id="{{meal.id}}">确认预约</view>
                  <view class="action-btn cancel-btn" bindtap="cancelAppointment" data-appointment-id="{{meal.id}}">取消预约</view>
                </block>
                
                <!-- 已确认状态按钮 -->
                <block wx:elif="{{meal.status === '已确认'}}">
                  <view class="action-btn complete-btn" bindtap="completeAppointment" data-appointment-id="{{meal.id}}">已完成</view>
                  <view class="action-btn cancel-btn" bindtap="cancelAppointment" data-appointment-id="{{meal.id}}">取消预约</view>
                </block>
                
                <!-- 已完成状态按钮 -->
                <block wx:elif="{{meal.status === '已完成'}}">
                  <view class="action-btn review-btn" bindtap="viewReview" data-appointment-id="{{meal.id}}" data-user-name="{{user.userName}}">查看评价</view>
                </block>
              </view>
              
              <!-- 已取消状态按钮 -->
              <view class="action-buttons" wx:elif="{{canManageAppointments && meal.status === '已取消'}}">
                <view class="action-btn reactivate-btn" bindtap="reactivateAppointment" data-appointment-id="{{meal.id}}">重新预约</view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <text class="empty-text">暂无预约安排</text>
      </view>
    </view>
  </view>

  <!-- 完成预约前的库存扣减预览 -->
  <view class="completion-overlay" wx:if="{{completionPreview}}">
    <view class="completion-modal">
      <view class="completion-modal-header">
        <view>
          <text class="completion-modal-title">确认完成预约</text>
          <text class="completion-modal-subtitle">以下是本次预计扣减的库存</text>
        </view>
        <view class="completion-alert">提醒</view>
      </view>

      <scroll-view class="completion-preview-scroll" scroll-y="true" show-scrollbar="false">
        <view class="preview-section">
          <view class="preview-section-title">预计扣减</view>
          <view wx:if="{{completionPreview.deductions.length > 0}}">
            <view class="deduction-row" wx:for="{{completionPreview.deductions}}" wx:key="id" wx:for-item="deduction">
              <text class="deduction-name">{{deduction.name}}</text>
              <text class="deduction-quantity">-{{deduction.quantity}}{{deduction.unit || ''}}</text>
            </view>
          </view>
          <view class="preview-empty" wx:else>暂无可自动扣减的库存</view>
        </view>

        <view class="preview-section preview-warning" wx:if="{{completionPreview.unresolved.length > 0}}">
          <view class="preview-section-title">需要留意</view>
          <text class="unresolved-row" wx:for="{{completionPreview.unresolved}}" wx:key="label" wx:for-item="unresolved">{{unresolved.label}}</text>
          <text class="unresolved-hint">未解决项目不会阻止完成，但请在备菜时留意。</text>
        </view>
      </scroll-view>

      <view class="completion-modal-actions">
        <button class="completion-cancel" disabled="{{isCompleting}}" bindtap="cancelCompletion">稍后确认</button>
        <button class="completion-confirm" loading="{{isCompleting}}" disabled="{{isCompleting}}" bindtap="confirmCompletion">确认完成并扣减</button>
      </view>
    </view>
  </view>
</view>
