<scroll-view class="container" scroll-y="true" enhanced="true" show-scrollbar="false">
  <!-- 日历部分 -->
  <view class="calendar-section">
    <calendar 
      id="calendar"
      view="week"
      mode="{{calendarMode}}"
      style="width:100%;--wc-primary:#19c8b9;--wc-primary-2:rgba(25,200,185,0.18);--wc-bg-light:#fff9e8;--wc-title-color-light:#794f27;--wc-title-sub-color-light:#725d42;--wc-op-bg-light:#e6f9f6;--wc-op-color-light:#0f8f85;--wc-week-color-light:#8a7b66;--wc-date-color-light:#794f27;--wc-mark-color-light:#9f927d;--wc-dot-color-light:#f7cd67;--wc-schedule-color-light:#0f8f85;--wc-schedule-bg-light:#e6f9f6;--wc-today-color-light:#0f8f85;--wc-solar-color-light:#e59266;--wc-checked-color-light:#794f27;--wc-checked-mark-color-light:#794f27;--wc-checked-dot-color-light:#794f27;--wc-checked-today-color-light:#fff9e8;--wc-checked-bg-light:#f7cd67;--wc-checked-today-bg-light:#19c8b9;--wc-control-bg-light:#c4b89e;--wc-panel-height:600rpx;--wc-title-size:42rpx;--wc-date-size:34rpx;"
      date="{{selectedDate}}"
      marks="{{markedDates}}"
      lunar="{{true}}"
      plugins="{{plugins}}"
      header="{{true}}"
      fold="{{false}}"
      bindload="onCalendarLoad"
      bindclick="onCalendarSelect"
      bindchange="onCalendarChange"
      bindviewchange="onViewChange"
    />
  </view>

  <!-- 预约列表部分 -->
  <view class="appointments-section">
    <view class="section-header">
      <text class="section-title">{{selectedDateDisplay}}预约</text>
      <view class="add-btn-mini" bindtap="addAppointment">
        <text class="add-icon"></text>
        <text class="add-text">添加预约</text>
      </view>
    </view>

    <view class="appointments-list">
      <!-- 加载状态 -->
      <view class="loading-state" wx:if="{{isLoading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      
      <!-- 预约列表 -->
      <block wx:elif="{{todayAppointments.length > 0}}">
        <view class="meal-card" wx:for="{{todayAppointments}}" wx:key="id">
          <view class="meal-header">
            <view class="meal-info">
              <text class="meal-type">{{item.mealType}}</text>
              <text class="dish-count">{{item.dishList.length}}道菜</text>
              <text class="appointment-status status-{{item.status === '待确认' ? 'pending' : item.status === '已确认' ? 'confirmed' : item.status === '已完成' ? 'completed' : 'cancelled'}}">{{item.status}}</text>
            </view>
            <view class="meal-actions">
              <!-- 根据状态显示不同按钮 -->
              <block wx:if="{{item.canEdit || item.canCancel}}">
                <view wx:if="{{item.canEdit}}" class="action-btn edit" bindtap="editAppointment" data-id="{{item.id}}">
                  <text class="action-text">修改</text>
                </view>
                <view wx:if="{{item.canCancel}}" class="action-btn delete" bindtap="deleteAppointment" data-id="{{item.id}}">
                  <text class="action-text">取消预约</text>
                </view>
              </block>
              <block wx:elif="{{item.canReview}}">
                <view class="action-btn review" bindtap="goToReview" data-id="{{item.id}}">
                  <text class="action-text">去评价</text>
                </view>
              </block>
              <block wx:elif="{{item.canReactivate}}">
                <view class="action-btn reactivate" bindtap="reactivateAppointment" data-id="{{item.id}}">
                  <text class="action-text">重新预约</text>
                </view>
              </block>
            </view>
          </view>
          <scroll-view class="dishes-list" scroll-x enable-flex show-scrollbar="false" enhanced="true">
            <view class="dish-item" wx:for="{{item.dishList}}" wx:key="id" wx:for-item="dish">
              <image referrerPolicy="no-referrer" class="dish-image" mode="aspectFill" src="{{dish.cachedImage || dish.images[0] || '/images/default-dish.png'}}"></image>
              <text class="dish-name">{{dish.name}}</text>
            </view>
          </scroll-view>
        </view>
      </block>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <text class="empty-text">暂无预约安排</text>
        <view class="empty-btn" bindtap="addAppointment">添加预约</view>
      </view>
    </view>
  </view>
  <view class="appointment-bottom-spacer"></view>
</scroll-view>
