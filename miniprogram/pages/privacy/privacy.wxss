.privacy-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--background-color);
  box-sizing: border-box;
}

.privacy-header {
  padding: 40rpx 32rpx 24rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
  padding-left: 20rpx;
  position: relative;
}

.privacy-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 34rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

.privacy-content {
  flex: 1;
  padding: 32rpx;
  background: var(--card-bg);
  margin: 20rpx 24rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  box-sizing: border-box;
}

.privacy-footer {
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--border-color);
  gap: 24rpx;
}

.btn-reject {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
  background: transparent;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--border-color);
  font-weight: 500;
}

.btn-accept {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: var(--primary-color);
  border-radius: var(--radius-full);
  border: none;
  font-weight: 600;
}

/* Animal Island native redesign */
.privacy-container {
  background: transparent;
}

.privacy-header,
.privacy-content,
.privacy-footer {
  background: #fff9e8;
  border: 4rpx solid rgba(121,79,39,0.16);
  box-shadow: 0 7rpx 0 rgba(121,79,39,0.10), 0 14rpx 24rpx rgba(61,52,40,0.12);
}

.privacy-header {
  margin: 16rpx 24rpx 0;
  border-radius: var(--radius-lg);
}

.privacy-title {
  font-weight: 900;
}

.privacy-title::before {
  background: var(--accent-yellow);
}

.privacy-content {
  border-radius: var(--radius-lg);
}

.privacy-footer {
  margin: 0 24rpx 16rpx;
  border-radius: var(--radius-lg);
}

.btn-reject,
.btn-accept {
  font-weight: 900;
  box-shadow: var(--shadow-fab);
}

.btn-accept {
  color: var(--text-color);
  background: var(--card-bg-light);
  border: 4rpx solid #fff7d6;
}
