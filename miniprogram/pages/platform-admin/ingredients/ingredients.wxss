page { height: 100vh; overflow: hidden; }
.catalog-page { position: relative; display: flex; flex-direction: column; height: 100vh; min-height: 0; color: var(--text-color); overflow: hidden; box-sizing: border-box; }
.catalog-header { position: relative; z-index: 2; flex-shrink: 0; padding: 28rpx 28rpx 24rpx; background: rgba(247,243,223,0.96); border-bottom: 2rpx solid rgba(121,79,39,0.12); border-radius: 0 0 34rpx 34rpx; box-shadow: 0 8rpx 20rpx rgba(61,52,40,0.08); }
.header-kicker { display: inline-block; padding: 5rpx 16rpx; color: var(--primary-dark); background: var(--primary-light); border: 2rpx solid rgba(25,200,185,0.28); border-radius: var(--radius-full); font-size: 20rpx; font-weight: 900; }
.header-row { display: flex; align-items: flex-start; gap: 18rpx; margin-top: 12rpx; }
.header-copy { min-width: 0; flex: 1; }
.header-title { color: var(--text-color); font-size: 44rpx; line-height: 1.22; font-weight: 900; }
.header-subtitle { margin-top: 8rpx; color: var(--text-light); font-size: 24rpx; line-height: 1.5; }
button::after { border: 0; }
.header-close { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 68rpx; height: 68rpx; margin: 0; padding: 0; background: var(--card-bg-light); border: 3rpx solid rgba(121,79,39,0.18); border-radius: 50%; box-shadow: 0 4rpx 0 rgba(121,79,39,0.1); }
.back-icon { transform: rotate(180deg); }
.catalog-scroll { position: relative; z-index: 1; flex: 1; min-height: 0; height: 0; box-sizing: border-box; padding: 22rpx 24rpx 0; overflow-x: hidden; }
.search-card { padding: 18rpx; background: var(--card-bg-light); border: 3rpx solid rgba(121,79,39,0.14); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.search-wrap { display: flex; align-items: center; height: 74rpx; box-sizing: border-box; padding: 0 16rpx; background: var(--input-bg); border: 3rpx solid var(--border-color); border-radius: var(--radius-sm); }
.search-input { min-width: 0; flex: 1; height: 70rpx; margin-left: 10rpx; color: var(--text-color); font-size: 25rpx; line-height: 70rpx; }
.search-clear { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; color: var(--text-light); font-size: 32rpx; }
.category-scroll { width: 100%; margin-top: 16rpx; white-space: nowrap; }
.category-row { display: inline-flex; gap: 12rpx; min-width: 100%; }
.category-pill { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; min-width: 102rpx; height: 54rpx; box-sizing: border-box; padding: 0 16rpx; color: var(--text-secondary); background: var(--input-bg); border: 3rpx solid var(--border-color); border-radius: var(--radius-full); font-size: 22rpx; font-weight: 800; }
.category-pill.active { color: var(--primary-dark); background: var(--primary-light); border-color: var(--primary-color); }
.catalog-summary { display: flex; align-items: baseline; justify-content: space-between; margin: 24rpx 6rpx 14rpx; }
.summary-title { color: var(--text-color); font-size: 30rpx; font-weight: 900; }
.summary-count { color: var(--text-light); font-size: 22rpx; }
.ingredient-list { display: flex; flex-direction: column; gap: 14rpx; }
.ingredient-card { display: flex; align-items: center; min-width: 0; gap: 16rpx; box-sizing: border-box; padding: 20rpx; background: var(--card-bg-light); border: 3rpx solid rgba(121,79,39,0.14); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.ingredient-card-copy { min-width: 0; flex: 1; }
.ingredient-name { overflow: hidden; color: var(--text-color); font-size: 29rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.ingredient-meta { display: flex; align-items: center; margin-top: 9rpx; color: var(--text-secondary); font-size: 22rpx; }
.meta-dot { margin: 0 8rpx; color: var(--accent-coral); }
.alias-copy { margin-top: 10rpx; overflow: hidden; color: var(--text-light); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.edit-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 62rpx; height: 62rpx; margin: 0; padding: 0; color: var(--primary-dark); background: var(--primary-light); border: 2rpx solid rgba(25,200,185,0.24); border-radius: 50%; font-size: 23rpx; font-weight: 900; }
.inline-loading, .list-end { padding: 12rpx 0; color: var(--text-light); font-size: 21rpx; text-align: center; }
.scroll-bottom-space { height: calc(210rpx + env(safe-area-inset-bottom)); }
.catalog-fab-wrap { position: fixed; right: 24rpx; bottom: calc(28rpx + env(safe-area-inset-bottom)); z-index: 20; }
.catalog-fab { display: flex; align-items: center; justify-content: center; height: 78rpx; margin: 0; padding: 0 28rpx 0 22rpx; color: #fff9e8; background: var(--primary-color); border: 4rpx solid #fff7d6; border-radius: var(--radius-full); box-shadow: var(--shadow-fab); font-size: 25rpx; font-weight: 900; line-height: 70rpx; }
.fab-plus { margin-right: 8rpx; font-size: 38rpx; font-weight: 400; line-height: 1; }
.state-card { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 340rpx; padding: 28rpx; text-align: center; background: var(--card-bg-light); border: 3rpx solid rgba(121,79,39,0.14); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); color: var(--text-color); font-size: 27rpx; font-weight: 900; }
.state-spinner { width: 44rpx; height: 44rpx; margin-bottom: 20rpx; border: 5rpx solid rgba(15,143,133,0.18); border-top-color: var(--primary-color); border-radius: 50%; animation: catalog-spin 0.9s linear infinite; }
@keyframes catalog-spin { to { transform: rotate(360deg); } }
.state-mark { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-bottom: 14rpx; color: #8a5b00; background: var(--warning-light); border-radius: 50%; font-size: 34rpx; }
.state-mark-soft { color: var(--primary-dark); background: var(--primary-light); }
.state-hint { margin-top: 10rpx; color: var(--text-light); font-size: 22rpx; font-weight: 400; line-height: 1.5; }
.state-button { height: 68rpx; margin: 24rpx 0 0; padding: 0 28rpx; color: var(--primary-dark); background: var(--primary-light); border: 2rpx solid rgba(25,200,185,0.25); border-radius: var(--radius-full); font-size: 24rpx; line-height: 64rpx; }
.editor-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 40; display: flex; align-items: flex-end; padding-top: env(safe-area-inset-top); background: rgba(61,52,40,0.38); }
.editor-sheet { width: 100%; max-height: calc(100vh - 80rpx); box-sizing: border-box; padding: 28rpx 28rpx 0; overflow-y: auto; background: var(--card-bg-light); border-radius: 36rpx 36rpx 0 0; box-shadow: 0 -10rpx 30rpx rgba(61,52,40,0.18); }
.sheet-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 26rpx; }
.sheet-kicker { color: var(--primary-dark); font-size: 19rpx; font-weight: 900; }
.sheet-title { margin-top: 8rpx; color: var(--text-color); font-size: 36rpx; font-weight: 900; }
.sheet-close { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin: 0; padding: 0; background: var(--input-bg); border: 2rpx solid var(--border-color); border-radius: 50%; }
.sheet-field { margin-bottom: 20rpx; }
.sheet-row { display: flex; gap: 14rpx; }
.sheet-half { min-width: 0; flex: 1; }
.field-label { margin-bottom: 10rpx; color: var(--text-secondary); font-size: 24rpx; font-weight: 800; }
.field-label.required::before { content: '*'; margin-right: 4rpx; color: var(--danger-color); }
.field-input { width: 100%; height: 78rpx; box-sizing: border-box; padding: 0 18rpx; color: var(--text-color); background: var(--input-bg); border: 3rpx solid var(--border-color); border-radius: var(--radius-sm); font-size: 26rpx; line-height: 72rpx; }
.field-hint { margin-top: 8rpx; color: var(--text-light); font-size: 21rpx; line-height: 1.5; }
.sheet-actions { display: flex; gap: 16rpx; margin: 26rpx 0 0; padding: 16rpx 0 14rpx; border-top: 2rpx dashed rgba(121,79,39,0.16); }
.sheet-cancel, .sheet-save { flex: 1; height: 78rpx; margin: 0; border-radius: var(--radius-full); font-size: 27rpx; font-weight: 900; line-height: 72rpx; }
.sheet-cancel { color: var(--text-secondary); background: var(--input-bg); border: 3rpx dashed var(--border-color); }
.sheet-save { color: #fff9e8; background: var(--primary-color); border: 0; box-shadow: 0 6rpx 0 var(--primary-dark); }
.sheet-save[disabled] { opacity: 0.55; }
.sheet-safe-area { height: env(safe-area-inset-bottom); }
