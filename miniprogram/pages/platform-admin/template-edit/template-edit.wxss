page { height: 100vh; overflow: hidden; }
.editor-page { position: relative; height: 100vh; overflow: hidden; color: var(--text-color); }
.editor-scroll { position: relative; z-index: 1; width: 100%; height: 100%; box-sizing: border-box; padding: 28rpx 24rpx 0; overflow-x: hidden; }
.editor-heading { margin: 0 4rpx 24rpx; }
.heading-kicker { display: inline-block; padding: 5rpx 16rpx; color: var(--primary-dark); background: var(--primary-light); border: 2rpx solid rgba(25,200,185,0.28); border-radius: var(--radius-full); font-size: 20rpx; font-weight: 900; }
.heading-row { display: flex; align-items: flex-start; gap: 18rpx; margin-top: 14rpx; }
.heading-copy { min-width: 0; flex: 1; }
.heading-title { color: var(--text-color); font-size: 44rpx; font-weight: 900; line-height: 1.22; }
.heading-subtitle { margin-top: 8rpx; color: var(--text-light); font-size: 24rpx; line-height: 1.5; }
button::after { border: 0; }
.heading-close { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 68rpx; height: 68rpx; margin: 0; padding: 0; background: var(--card-bg-light); border: 3rpx solid rgba(121,79,39,0.18); border-radius: 50%; box-shadow: 0 4rpx 0 rgba(121,79,39,0.1); }
.editor-card { box-sizing: border-box; margin-bottom: 18rpx; padding: 24rpx; background: var(--card-bg-light); border: 3rpx solid rgba(121,79,39,0.14); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.section-heading-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.section-title { margin-bottom: 20rpx; color: var(--text-color); font-size: 29rpx; font-weight: 900; }
.section-count { flex-shrink: 0; color: var(--text-light); font-size: 21rpx; }
.field-group { margin-bottom: 22rpx; }
.field-group:last-child { margin-bottom: 0; }
.field-row { display: flex; gap: 16rpx; }
.field-half { flex: 1; min-width: 0; }
.field-label { margin-bottom: 10rpx; color: var(--text-secondary); font-size: 23rpx; font-weight: 800; }
.field-label.required::before { content: '*'; margin-right: 4rpx; color: var(--danger-color); }
.field-input, .field-picker { width: 100%; height: 78rpx; box-sizing: border-box; padding: 0 20rpx; color: var(--text-color); background: var(--input-bg); border: 3rpx solid var(--border-color); border-radius: var(--radius-sm); font-size: 27rpx; line-height: 72rpx; }
.field-input:focus { border-color: var(--primary-color); }
.field-picker { display: flex; align-items: center; justify-content: space-between; }
.field-picker text { color: var(--text-light); font-size: 30rpx; }
.image-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.image-item, .image-add { position: relative; width: 142rpx; height: 142rpx; box-sizing: border-box; overflow: hidden; border-radius: var(--radius-sm); }
.dish-image { width: 100%; height: 100%; }
.image-add { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--primary-dark); background: var(--primary-light); border: 3rpx dashed rgba(15,143,133,0.42); font-size: 20rpx; font-weight: 800; }
.image-plus { position: relative; width: 40rpx; height: 40rpx; margin-bottom: 8rpx; }
.image-plus::before, .image-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 34rpx; height: 4rpx; background: var(--primary-color); border-radius: var(--radius-full); transform: translate(-50%, -50%); }
.image-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
.image-delete { position: absolute; top: 6rpx; right: 6rpx; display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; color: #fff9e8; background: rgba(61,52,40,0.7); border-radius: 50%; font-size: 28rpx; line-height: 1; }
.section-hint { margin-top: 14rpx; color: var(--text-light); font-size: 21rpx; line-height: 1.5; }
.ingredient-list, .step-list { display: flex; flex-direction: column; gap: 14rpx; }
.ingredient-row { display: flex; align-items: flex-start; gap: 12rpx; min-width: 0; padding: 14rpx 12rpx; background: rgba(234,245,240,0.7); border-radius: var(--radius-sm); }
.ingredient-index, .step-index { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 42rpx; height: 42rpx; color: var(--primary-dark); background: var(--primary-light); border-radius: 50%; font-size: 21rpx; font-weight: 900; }
.ingredient-fields { min-width: 0; flex: 1; }
.ingredient-name, .ingredient-amount, .ingredient-unit { box-sizing: border-box; height: 62rpx; padding: 0 14rpx; color: var(--text-color); background: var(--card-bg-light); border: 2rpx solid var(--border-color); border-radius: var(--radius-sm); font-size: 24rpx; }
.ingredient-name { width: 100%; }
.ingredient-measure-row { display: flex; gap: 10rpx; margin-top: 10rpx; }
.ingredient-amount { flex: 1; min-width: 0; }
.ingredient-unit { width: 140rpx; }
.row-delete { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 46rpx; height: 46rpx; margin: 0; padding: 0; color: var(--text-light); background: transparent; border: 0; font-size: 34rpx; line-height: 1; }
.row-delete:active, .image-delete:active { color: var(--danger-color); }
.inline-add { display: flex; align-items: center; justify-content: center; width: 100%; height: 66rpx; margin: 16rpx 0 0; color: var(--primary-dark); background: var(--primary-light); border: 2rpx dashed rgba(15,143,133,0.35); border-radius: var(--radius-sm); font-size: 24rpx; font-weight: 900; line-height: 62rpx; }
.inline-add text { margin-right: 8rpx; font-size: 34rpx; font-weight: 400; }
.step-row { display: flex; align-items: flex-start; gap: 12rpx; min-width: 0; padding: 12rpx; background: rgba(255,249,232,0.86); border-radius: var(--radius-sm); }
.step-input { min-height: 72rpx; flex: 1; box-sizing: border-box; padding: 10rpx 14rpx; color: var(--text-color); background: var(--card-bg-light); border: 2rpx solid var(--border-color); border-radius: var(--radius-sm); font-size: 25rpx; line-height: 1.45; }
.step-delete { margin-top: 8rpx; }
.note-input { width: 100%; min-height: 130rpx; box-sizing: border-box; padding: 16rpx; color: var(--text-color); background: var(--input-bg); border: 3rpx solid var(--border-color); border-radius: var(--radius-sm); font-size: 25rpx; line-height: 1.5; }
.reference-field { margin-top: 20rpx; }
.editor-bottom-space { height: calc(230rpx + env(safe-area-inset-bottom)); }
.editor-bottom-fixed { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; }
.editor-bottom-dock { position: absolute; right: 0; bottom: 0; left: 0; height: calc(220rpx + env(safe-area-inset-bottom)); pointer-events: none; background: linear-gradient(180deg, rgba(255,249,232,0) 0%, rgba(255,249,232,0.96) 22%, #fff9e8 48%, #fff9e8 100%); border-radius: 44rpx 44rpx 0 0; box-shadow: 0 -18rpx 38rpx rgba(61,52,40,0.1); }
.editor-actions { position: relative; z-index: 1; display: flex; gap: 16rpx; box-sizing: border-box; margin: 0 24rpx; padding: 16rpx 20rpx 14rpx; background: #fff9e8; border: 4rpx solid rgba(121,79,39,0.18); border-radius: var(--radius-lg); box-shadow: 0 8rpx 0 rgba(121,79,39,0.12), 0 16rpx 30rpx rgba(61,52,40,0.14); }
.cancel-button, .save-button { flex: 1; min-width: 0; height: 80rpx; margin: 0; border-radius: var(--radius-full); font-size: 28rpx; font-weight: 900; line-height: 74rpx; }
.cancel-button { color: var(--text-secondary); background: var(--card-bg-light); border: 3rpx dashed var(--border-color); }
.save-button { color: #fff9e8; background: var(--primary-color); border: 0; box-shadow: 0 6rpx 0 var(--primary-dark); }
.save-button[disabled] { opacity: 0.55; }
.editor-safe-area { position: relative; z-index: 1; height: env(safe-area-inset-bottom); background: #fff9e8; }
.state-card { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 360rpx; margin-top: 20rpx; padding: 28rpx; text-align: center; background: var(--card-bg-light); border: 3rpx solid rgba(121,79,39,0.14); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); color: var(--text-color); font-size: 27rpx; font-weight: 900; }
.state-spinner { width: 44rpx; height: 44rpx; margin-bottom: 20rpx; border: 5rpx solid rgba(15,143,133,0.18); border-top-color: var(--primary-color); border-radius: 50%; animation: editor-spin 0.9s linear infinite; }
@keyframes editor-spin { to { transform: rotate(360deg); } }
.state-mark { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-bottom: 14rpx; color: #8a5b00; background: var(--warning-light); border-radius: 50%; font-size: 34rpx; }
.state-button { height: 68rpx; margin: 24rpx 0 0; padding: 0 28rpx; color: var(--primary-dark); background: var(--primary-light); border: 2rpx solid rgba(25,200,185,0.25); border-radius: var(--radius-full); font-size: 24rpx; line-height: 64rpx; }
