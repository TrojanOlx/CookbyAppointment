page {
  height: 100vh;
  overflow: hidden;
}

.family-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.family-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  height: 100vh;
  padding: 40rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.family-heading {
  margin: 8rpx 4rpx 28rpx;
}

.family-kicker {
  display: inline-block;
  padding: 5rpx 16rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 2rpx solid rgba(25, 200, 185, 0.28);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.family-title {
  margin-top: 18rpx;
  color: var(--text-color);
  font-size: 44rpx;
  font-weight: 900;
}

.family-subtitle {
  margin-top: 8rpx;
  color: var(--text-light);
  font-size: 26rpx;
  line-height: 1.5;
}

.family-login-card,
.family-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
  padding: 42rpx 32rpx;
  background:
    radial-gradient(circle, rgba(248,166,178,0.10) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    radial-gradient(circle, rgba(255,255,255,0.22) 1.5rpx, transparent 2.5rpx) 12rpx 12rpx/28rpx 28rpx,
    var(--card-bg-light);
  border: 4rpx solid rgba(121, 79, 39, 0.14);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  text-align: center;
}

.family-login-card {
  flex-direction: row;
  align-items: center;
  padding: 28rpx;
  text-align: left;
}

.family-login-icon {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.family-login-copy {
  flex: 1;
  min-width: 0;
}

.family-card-title {
  color: var(--text-color);
  font-size: 32rpx;
  font-weight: 900;
}

.family-card-subtitle {
  margin-top: 8rpx;
  color: var(--text-light);
  font-size: 25rpx;
  line-height: 1.5;
}

button::after { border: 0; }

.family-link-btn,
.toolbar-add,
.family-manage-btn {
  margin: 0;
  padding: 0;
  color: var(--primary-dark);
  background: transparent;
  border: 0;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.5;
  white-space: nowrap;
  transition: transform var(--motion-press) var(--ease-out);
}

.family-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-width: 0;
  min-height: 64rpx;
  margin: 0 4rpx 20rpx;
}

.toolbar-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
  margin-left: 16rpx;
}

.toolbar-caption {
  min-width: 0;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toolbar-add,
.toolbar-join {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto !important;
  min-width: 156rpx;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: var(--radius-full);
  line-height: 64rpx;
}

.toolbar-add {
  color: #fff9e8;
  background: var(--primary-color);
  box-shadow: 0 5rpx 0 var(--primary-dark);
}

.toolbar-join {
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 2rpx solid rgba(25, 200, 185, 0.32);
}

.toolbar-action-icon { margin-right: 6rpx; }

.family-loading {
  padding: 100rpx 0;
  color: var(--text-light);
  font-size: 28rpx;
  text-align: center;
}

.family-error {
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 20rpx;
  padding: 24rpx;
  overflow: hidden;
  background:
    radial-gradient(circle, rgba(224,90,90,0.08) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    var(--danger-light);
  border: 3rpx solid rgba(224,90,90,0.24);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.family-error-icon {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
}

.family-error-copy {
  min-width: 0;
  flex: 1;
}

.family-error .family-card-subtitle {
  overflow-wrap: anywhere;
}

.family-retry-btn {
  width: 150rpx;
  height: 62rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0 14rpx;
  box-sizing: border-box;
  color: var(--danger-color);
  background: #fff9e8;
  border: 0;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 62rpx;
  transition: transform var(--motion-press) var(--ease-out);
}

.family-retry-btn::after { border: 0; }
.family-retry-btn:active { transform: scale(0.97); }

.family-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.family-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 116rpx;
  padding: 18rpx 20rpx;
  overflow: hidden;
  background:
    radial-gradient(circle, rgba(247,205,103,0.12) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    var(--card-bg);
  border: 3rpx solid rgba(159, 146, 125, 0.32);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: transform var(--motion-press) var(--ease-out);
}

.family-item.is-active {
  border-color: var(--primary-color);
  background: var(--card-bg-light);
  box-shadow: 0 7rpx 0 rgba(15, 143, 133, 0.22), 0 14rpx 26rpx rgba(61, 52, 40, 0.1);
}

.family-item:active { transform: translateY(3rpx); }

.family-item-main,
.family-item-title-row {
  display: flex;
  align-items: center;
}

.family-item-main {
  flex: 1;
  min-width: 0;
}

.family-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  color: #fff9e8;
  background: var(--accent-orange);
  border: 3rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.family-item-copy {
  flex: 1;
  min-width: 0;
}

.family-item-title-row {
  min-width: 0;
  gap: 10rpx;
}

.family-item-name {
  min-width: 0;
  overflow: hidden;
  color: var(--text-color);
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-item-meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--text-light);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active-mark {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border-radius: var(--radius-full);
  font-size: 21rpx;
  font-weight: 900;
}

.family-manage-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112rpx !important;
  min-width: 112rpx;
  height: 56rpx;
  margin-left: 16rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: var(--text-color);
  background: var(--warning-light);
  border: 2rpx solid rgba(247, 205, 103, 0.46);
  border-radius: var(--radius-full);
  font-size: 23rpx;
  line-height: 56rpx;
}

.family-manage-arrow { margin-left: 7rpx; }

.family-primary-btn,
.family-secondary-btn {
  box-sizing: border-box;
  width: auto !important;
  min-width: 0;
  height: 82rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 82rpx;
  transition: transform var(--motion-press) var(--ease-out);
}

.family-primary-btn {
  flex: 1;
  color: #fff9e8;
  background: var(--primary-color);
  box-shadow: 0 7rpx 0 var(--primary-dark);
}

.family-secondary-btn {
  flex: 1;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 3rpx solid rgba(25, 200, 185, 0.32);
}

.family-empty-actions {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-top: 28rpx;
}

.family-empty-icon {
  width: 190rpx;
  height: 140rpx;
  margin-bottom: 18rpx;
}

.family-tip {
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  max-width: 100%;
  margin: 24rpx 8rpx;
  color: var(--text-light);
  font-size: 23rpx;
  line-height: 1.5;
}

.family-tip image {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin: 2rpx 10rpx 0 0;
}

@media (max-width: 360px) {
  .family-toolbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 14rpx;
  }

  .toolbar-actions {
    width: 100%;
    margin-left: 0;
  }

  .toolbar-add,
  .toolbar-join {
    flex: 1;
  }
}

.family-link-btn:active,
.toolbar-add:active,
.toolbar-join:active,
.family-manage-btn:active,
.family-primary-btn:active,
.family-secondary-btn:active {
  transform: scale(0.97);
}

@media (prefers-reduced-motion: reduce) {
  .family-link-btn,
  .toolbar-add,
  .toolbar-join,
  .family-retry-btn,
  .family-item,
  .family-manage-btn,
  .family-primary-btn,
  .family-secondary-btn {
    transition: none;
  }

  .family-link-btn:active,
  .toolbar-add:active,
  .toolbar-join:active,
  .family-retry-btn:active,
  .family-item:active,
  .family-manage-btn:active,
  .family-primary-btn:active,
  .family-secondary-btn:active {
    transform: none !important;
  }
}
