page {
  height: 100vh;
  overflow: hidden;
}

.family-form-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.family-form-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  height: 100vh;
  padding: 46rpx 28rpx 0;
  overflow-x: hidden;
}

.form-heading { margin: 8rpx 4rpx 34rpx; }

.form-kicker {
  display: inline-block;
  padding: 5rpx 16rpx;
  color: #8a5b00;
  background: var(--warning-light);
  border: 2rpx solid rgba(247, 205, 103, 0.5);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.form-title {
  margin-top: 18rpx;
  color: var(--text-color);
  font-size: 46rpx;
  font-weight: 900;
}

.form-subtitle {
  margin-top: 8rpx;
  color: var(--text-light);
  font-size: 26rpx;
}

.form-card {
  box-sizing: border-box;
  padding: 32rpx 28rpx 36rpx;
  overflow: hidden;
  background:
    radial-gradient(circle, rgba(248,166,178,0.10) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    radial-gradient(circle, rgba(255,255,255,0.22) 1.5rpx, transparent 2.5rpx) 12rpx 12rpx/28rpx 28rpx,
    var(--card-bg-light);
  border: 4rpx solid rgba(121, 79, 39, 0.14);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.form-label {
  margin-bottom: 14rpx;
  color: var(--text-color);
  font-size: 28rpx;
  font-weight: 900;
}

.timezone-label { margin-top: 32rpx; }

.family-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  color: var(--text-color);
  background: var(--input-bg);
  border: 3rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  font-size: 30rpx;
}

.family-input:focus { border-color: var(--primary-color); }
.family-placeholder { color: var(--text-light); }

.form-hint {
  margin-top: 10rpx;
  color: var(--text-light);
  font-size: 23rpx;
  line-height: 1.5;
}

.form-note {
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  max-width: 100%;
  margin: 24rpx 8rpx 30rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.form-note image {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin: 3rpx 10rpx 0 0;
}

button::after { border: 0; }

.form-primary-btn,
.form-cancel-btn {
  box-sizing: border-box;
  max-width: 100%;
  flex: 1;
  min-width: 0;
  height: 82rpx;
  margin: 0;
  border-radius: var(--radius-full);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.form-primary-btn {
  color: #fff9e8;
  background: var(--primary-color);
  box-shadow: 0 7rpx 0 var(--primary-dark);
}

.form-primary-btn[disabled] { opacity: 0.58; }

.form-cancel-btn {
  color: var(--text-secondary);
  background: var(--card-bg-light);
  border: 3rpx dashed var(--border-color);
}

.form-bottom-spacer {
  height: calc(212rpx + env(safe-area-inset-bottom));
}

.form-bottom-fixed {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
}

.form-bottom-dock {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  height: calc(218rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(255,249,232,0) 0%,
    rgba(255,249,232,0.96) 18%,
    #fff9e8 42%,
    #fff9e8 100%
  );
  border-radius: 44rpx 44rpx 0 0;
  box-shadow: 0 -18rpx 38rpx rgba(61,52,40,0.10);
}

.form-actions {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  box-sizing: border-box;
  margin: 0 24rpx;
  padding: 16rpx 20rpx 14rpx;
  background: #fff9e8;
  border: 4rpx solid rgba(121,79,39,0.18);
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 0 rgba(121,79,39,0.12), 0 16rpx 30rpx rgba(61,52,40,0.14);
}

.form-safe-area {
  position: relative;
  z-index: 1;
  height: env(safe-area-inset-bottom);
}
