page {
  height: 100vh;
  overflow: hidden;
}

.invite-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.invite-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  height: 100vh;
  padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.invite-scroll--with-dock {
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.invite-heading { margin: 6rpx 4rpx 26rpx; }

.invite-heading--create {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.invite-heading-copy {
  min-width: 0;
  flex: 1;
}

.invite-heading-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  background: var(--card-bg-light);
  border: 3rpx solid rgba(25, 200, 185, 0.30);
  border-radius: 30rpx;
  box-shadow: 0 6rpx 0 rgba(15, 143, 133, 0.12);
}

.invite-kicker {
  display: inline-block;
  padding: 5rpx 16rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 2rpx solid rgba(25, 200, 185, 0.28);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.invite-title {
  margin-top: 12rpx;
  color: var(--text-color);
  font-size: 44rpx;
  font-weight: 900;
}

.invite-subtitle {
  margin-top: 8rpx;
  color: var(--text-light);
  font-size: 26rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.invite-loading {
  padding: 100rpx 0;
  color: var(--text-light);
  font-size: 28rpx;
  text-align: center;
}

.invite-preview-card,
.invite-create-card,
.invite-token-card,
.invite-error {
  box-sizing: border-box;
  overflow: hidden;
  padding: 30rpx 28rpx;
  background:
    radial-gradient(circle, rgba(248,166,178,0.10) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    radial-gradient(circle, rgba(255,255,255,0.22) 1.5rpx, transparent 2.5rpx) 12rpx 12rpx/28rpx 28rpx,
    var(--card-bg-light);
  border: 4rpx solid rgba(121, 79, 39, 0.14);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.invite-preview-card,
.invite-error { text-align: center; }

.invite-family-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 18rpx;
  color: #fff9e8;
  background: var(--accent-orange);
  border: 4rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 38rpx;
  font-size: 52rpx;
  font-weight: 900;
}

.invite-family-name {
  color: var(--text-color);
  font-size: 38rpx;
  font-weight: 900;
}

.invite-family-meta {
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 27rpx;
}

.invite-expiry {
  margin-top: 16rpx;
  color: var(--text-light);
  font-size: 23rpx;
}

.invite-status {
  margin-top: 22rpx;
  padding: 14rpx 20rpx;
  color: var(--text-secondary);
  background: var(--input-bg);
  border-radius: var(--radius-sm);
  font-size: 25rpx;
  font-weight: 800;
}

.invite-card-title {
  color: var(--text-color);
  font-size: 32rpx;
  font-weight: 900;
}

.invite-card-subtitle {
  margin-top: 10rpx;
  color: var(--text-light);
  font-size: 25rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.invite-error image {
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 14rpx;
}

.create-label,
.token-label {
  color: var(--text-color);
  font-size: 28rpx;
  font-weight: 900;
}

.create-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.create-current {
  flex-shrink: 0;
  padding: 5rpx 14rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border-radius: var(--radius-full);
  font-size: 21rpx;
  font-weight: 900;
}

.create-hint {
  margin-top: 18rpx;
  color: var(--text-light);
  font-size: 24rpx;
  line-height: 1.55;
}

island-tabs { display: block; margin-top: 18rpx; }

button::after { border: 0; }

.invite-primary-btn,
.invite-secondary-btn,
.invite-share-btn {
  box-sizing: border-box;
  max-width: 100%;
  width: 100%;
  height: 82rpx;
  margin: 26rpx 0 0;
  border-radius: var(--radius-full);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.invite-primary-btn {
  color: #fff9e8;
  background: var(--primary-color);
  box-shadow: 0 7rpx 0 var(--primary-dark);
}

.invite-primary-btn[disabled] { opacity: 0.58; }

.invite-secondary-btn {
  color: var(--text-secondary);
  background: transparent;
  border: 3rpx dashed var(--border-color);
}

.invite-share-btn {
  color: var(--text-color);
  background: var(--warning-light);
  border: 3rpx solid rgba(247, 205, 103, 0.46);
}

.invite-token-card {
  margin-top: 20rpx;
  text-align: center;
}

.token-value {
  margin-top: 16rpx;
  padding: 20rpx 10rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 3rpx dashed rgba(25, 200, 185, 0.48);
  border-radius: var(--radius-sm);
  font-size: 42rpx;
  font-weight: 900;
  letter-spacing: 0;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.token-meta {
  margin-top: 12rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.invite-code-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed rgba(121, 79, 39, 0.20);
}

.invite-code-title {
  color: var(--text-color);
  font-size: 28rpx;
  font-weight: 900;
}

.invite-code-image,
.invite-code-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 360rpx;
  height: 360rpx;
  max-width: 100%;
  margin: 18rpx auto 0;
  background: #fff;
  border: 3rpx solid rgba(159, 146, 125, 0.28);
  border-radius: var(--radius-md);
}

.invite-code-placeholder {
  flex-direction: column;
  gap: 18rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.invite-code-loading-dot {
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid var(--primary-light);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: invite-code-spin 0.8s linear infinite;
}

@keyframes invite-code-spin {
  to { transform: rotate(360deg); }
}

.invite-code-error {
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  padding: 20rpx;
  color: var(--danger-color);
  background: var(--danger-light);
  border: 2rpx solid rgba(224, 90, 90, 0.20);
  border-radius: var(--radius-md);
  font-size: 23rpx;
  line-height: 1.5;
}

.invite-code-error button {
  width: auto !important;
  height: 58rpx;
  margin: 16rpx auto 0;
  padding: 0 24rpx;
  color: var(--danger-color);
  background: #fff9e8;
  border-radius: var(--radius-full);
  font-size: 23rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.invite-code-hint {
  margin-top: 12rpx;
  color: var(--text-light);
  font-size: 22rpx;
}

.invite-token-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.invite-token-actions .invite-secondary-btn {
  min-width: 0;
  flex: 1;
  margin-top: 0;
  padding: 0 14rpx;
  font-size: 25rpx;
}

.invite-token-actions .invite-secondary-btn[disabled] { opacity: 0.48; }

.invite-bottom-fixed {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255,249,232,0), rgba(255,249,232,0.96) 28%);
}

.invite-bottom-panel {
  display: flex;
  gap: 16rpx;
  margin: 32rpx 24rpx 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: rgba(255,249,232,0.98);
  border: 3rpx solid rgba(121,79,39,0.16);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.invite-dock-secondary,
.invite-dock-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.invite-dock-secondary {
  flex: 0 0 220rpx;
  color: var(--text-secondary);
  background: transparent;
  border: 3rpx dashed var(--border-color);
}

.invite-dock-primary {
  flex: 1;
  color: #fff9e8;
  background: var(--primary-color);
  box-shadow: 0 6rpx 0 var(--primary-dark);
}

.invite-dock-primary[disabled] { opacity: 0.58; }
.invite-dock-icon { margin-right: 8rpx; }
.invite-safe-area { height: env(safe-area-inset-bottom); }

@media (max-width: 340px) {
  .invite-heading-mark {
    width: 82rpx;
    height: 82rpx;
  }

  .invite-title { font-size: 40rpx; }
  .invite-dock-secondary { flex-basis: 184rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .invite-code-loading-dot { animation: none; }
}
