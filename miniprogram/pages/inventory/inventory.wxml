<view class="container" bindtap="onContainerTap">
  <view class="fixed-page-bg"></view>
  <view class="inventory-top-dock"></view>
  <!-- 搜索区域 -->
  <view class="search-bar">
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="搜索食材" 
        value="{{searchKeyword}}" 
        maxlength="80"
        cursor-spacing="16"
        bindinput="onSearchInput" 
        confirm-type="search"
        catchtap="stopEvent"
      />
      <mp-icon ext-class="search-icon" icon="search" size="19" color="#9f927d"></mp-icon>
    </view>
  </view>

  <!-- 筛选组件 -->
  <view class="filter-bar">
    <view 
      class="filter-item {{filterStatus === '' ? 'active' : ''}}" 
      bindtap="filterByStatus" 
      data-status=""
    >
      <text>全部</text>
      <text class="count">{{totalCount}}</text>
    </view>
    <view 
      class="filter-item {{filterStatus === 'normal' ? 'active' : ''}}" 
      bindtap="filterByStatus" 
      data-status="normal"
    >
      <text>未到期</text>
      <text class="count">{{normalCount}}</text>
    </view>
    <view 
      class="filter-item {{filterStatus === 'expiring' ? 'active' : ''}}" 
      bindtap="filterByStatus" 
      data-status="expiring"
    >
      <text>即将过期</text>
      <text class="count">{{expiringCount}}</text>
    </view>
    <view 
      class="filter-item {{filterStatus === 'expired' ? 'active' : ''}}" 
      bindtap="filterByStatus" 
      data-status="expired"
    >
      <text>已过期</text>
      <text class="count">{{expiredCount}}</text>
    </view>
  </view>

  <!-- 库存列表（滚动区域） -->
  <view class="inventory-scroll-container">
    <scroll-view 
      class="inventory-list" 
      scroll-y="true"
      enable-flex="true"
      enable-back-to-top
      refresher-enabled
      refresher-threshold="50"
      refresher-default-style="black"
      refresher-background="#a8d8b9"
      refresher-triggered="{{isRefreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onReachBottom"
      bindscroll="onScroll"
      enhanced="{{true}}"
      show-scrollbar="false"
      fast-deceleration="{{true}}"
      scroll-anchoring="{{true}}"
    >
      <!-- 加载状态 -->
      <view class="loading-container" wx:if="{{loading && items.length === 0}}">
        <view class="loading-spinner"></view>
        <view class="loading-text">加载中...</view>
      </view>

      <!-- 列表内容 -->
      <block wx:if="{{items.length > 0}}">
        <view class="inventory-item-container" wx:for="{{items}}" wx:key="id">
          <movable-area class="movable-area">
            <movable-view class="movable-view" out-of-bounds="true" direction="horizontal" x="{{item.xmove}}" inertia="true" 
              data-index="{{index}}" bindtouchstart="handleTouchStart" bindtouchend="handleTouchEnd" bindchange="handleMovableChange" catchtap="stopEvent"
              damping="40" friction="5">
              <view class="inventory-item" bindtap="editItem" data-id="{{item.id}}">
                <!-- 左侧图片区域 -->
                <view class="item-image">
                  <image referrerPolicy="no-referrer" src="{{item.cachedImage || item.image || '/images/default-dish.jpg'}}" mode="aspectFill" lazy-load="true" data-id="{{item.id}}" data-index="{{index}}" binderror="onItemImageError"></image>
                </view>
                
                <view class="item-body">
                  <view class="item-heading">
                    <view class="item-name">{{item.name}}</view>
                    <view class="days-left {{item.isExpired ? 'expired' : item.isExpiringSoon ? 'expiring-soon' : ''}}" wx:if="{{item.isExpired || item.daysLeft !== null}}">
                      {{item.isExpired ? '已过期' : '剩' + item.daysLeft + '天'}}
                    </view>
                  </view>
                  <view class="item-amount">{{item.amount}}</view>
                  <view class="item-date-summary">
                    <view class="item-date-pair">
                      <text class="date-label">放入</text>
                      <text class="date-value">{{item.putInDate}}</text>
                    </view>
                    <view class="item-date-pair">
                      <text class="date-label">到期</text>
                      <text class="date-value {{item.isExpired ? 'expired' : item.isExpiringSoon ? 'expiring-soon' : ''}}">{{item.expiryDate}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </movable-view>
          </movable-area>
          <view class="movable-delete-btn" catchtap="deleteItem" data-id="{{item.id}}">删除</view>
        </view>

        <!-- 底部加载更多提示 -->
        <view class="load-more-tip" wx:if="{{isLoadingMore}}">
          <view class="loading-spinner small"></view>
          <text class="loading-text">加载更多...</text>
        </view>
        
        <!-- 底部无更多数据提示 -->
        <view class="no-more-tip" wx:if="{{!isLoadingMore && !hasMore && filteredTotal > pageSize}}">
          <text>没有更多了</text>
        </view>
      </block>
      <view class="empty-tip" wx:elif="{{!loading}}">
        <view class="empty-text">暂无库存，请添加</view>
        <view class="seed-btn" wx:if="{{!searchKeyword && totalCount === 0}}" bindtap="seedTestInventory">添加示例库存</view>
      </view>
      <view class="fab-scroll-spacer" aria-hidden="true"></view>
    </scroll-view>
  </view>

  <!-- 添加按钮 -->
  <view class="add-btn" bindtap="addItem" style="bottom: calc(28rpx + {{safeAreaBottom}}px);">
    <mp-icon ext-class="add-icon" icon="add" size="27" color="#0f8f85"></mp-icon>
  </view>
</view>
