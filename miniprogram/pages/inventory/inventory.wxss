.container {
  position: relative;
  height: 100vh;
  background: var(--background-color);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

page {
  height: 100vh;
  overflow: hidden;
}

/* ── 搜索 + 筛选 固定头部 ── */
.search-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--card-bg);
  padding: 16rpx 24rpx 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.search-box {
  position: relative;
  margin-bottom: 0;
}

.search-input {
  height: 72rpx;
  background: var(--input-bg);
  border-radius: var(--radius-full);
  padding: 0 72rpx 0 40rpx;
  font-size: 28rpx;
  color: var(--text-color);
  width: 100%;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

/* ── 筛选 Tab ── */
.filter-bar {
  position: fixed;
  top: 100rpx;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  flex-direction: row;
  background: var(--card-bg);
  height: 80rpx;
  border-bottom: 1rpx solid var(--border-color);
  margin-top: 0;
}

.filter-item {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: color 0.2s;
}
.filter-item.active {
  color: var(--primary-color);
  font-weight: 700;
}
.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.filter-item .count {
  font-size: 18rpx;
  color: var(--text-light);
  margin-top: 2rpx;
}
.filter-item.active .count { color: var(--primary-color); }

/* ── 列表容器 ── */
.inventory-scroll-container {
  position: relative;
  z-index: 1;
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.inventory-list {
  display: block;
  height: 100%;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 0 calc(148rpx + env(safe-area-inset-bottom));
  -webkit-overflow-scrolling: touch;
  overflow-x: hidden;
}

/* ── 滑动删除 ── */
.inventory-item-container {
  margin-bottom: 18rpx;
  width: 100%;
  height: 194rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  display: flex;
  position: relative;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.movable-area {
  height: 194rpx;
  width: 100%;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  z-index: 3;
}

.movable-view {
  width: 100%;
  height: 194rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
}

.movable-delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  width: 140rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: var(--danger-color);
  border-top-right-radius: var(--radius-lg);
  border-bottom-right-radius: var(--radius-lg);
}

/* ── 列表项 ── */
.inventory-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.item-image {
  width: 108rpx;
  height: 108rpx;
  min-width: 108rpx;
  margin-right: 18rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--input-bg);
}
.item-image image { width: 100%; height: 100%; }

.item-body {
  flex: 1;
  min-width: 0;
}

.item-heading {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.item-name {
  min-width: 0;
  flex: 1;
  font-size: 31rpx;
  font-weight: 900;
  color: var(--text-color);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-amount {
  display: inline-flex;
  align-items: center;
  max-width: 260rpx;
  min-height: 40rpx;
  margin-top: 7rpx;
  padding: 0 15rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  background: rgba(76,175,80,0.1);
  font-size: 24rpx;
  color: var(--primary-color);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-date-summary {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 20rpx;
  margin-top: 10rpx;
}

.item-date-pair {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 6rpx;
}

.date-label {
  flex-shrink: 0;
  font-size: 19rpx;
  color: var(--text-light);
  white-space: nowrap;
}

.date-value {
  min-width: 0;
  font-size: 20rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.days-left {
  min-height: 38rpx;
  flex-shrink: 0;
  padding: 0 12rpx;
  border-radius: var(--radius-full);
  background: rgba(76,175,80,0.1);
  font-size: 20rpx;
  color: var(--primary-color);
  font-weight: 600;
  display: flex;
  align-items: center;
}
.expired {
  color: var(--danger-color) !important;
  font-weight: 600;
}
.expiring-soon {
  color: var(--warning-color) !important;
  font-weight: 600;
}
.days-left.expired { background: rgba(244,67,54,0.1); }
.days-left.expiring-soon { background: rgba(255,152,0,0.12); }

/* ── 空状态 ── */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 8rpx;
  padding: 120rpx 40rpx;
  gap: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}
.empty-text { font-size: 30rpx; color: var(--text-light); }

.seed-btn {
  min-width: 220rpx;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-full);
  background: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  transition: opacity 0.15s ease;
}
.seed-btn:active { opacity: 0.82; }

/* ── 加载 ── */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #E8E8E8;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-spinner.small { width: 32rpx; height: 32rpx; border-width: 4rpx; }
.loading-text { font-size: 26rpx; color: var(--text-light); }

@keyframes spin {
  to { transform: rotate(360deg); }
}

.load-more-tip, .no-more-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  color: var(--text-light);
  font-size: 24rpx;
}

/* ── FAB ── */
.add-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-fab);
  z-index: 9000;
  transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
}
.add-btn:active {
  transform: scale(0.93);
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.22);
}

.add-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn-container { display: none; }

/* Animal Island native redesign */
.container {
  background: transparent;
}

.inventory-top-dock {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 224rpx;
  z-index: 120;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    #fff9e8 0%,
    #fff9e8 82%,
    rgba(255,249,232,0.58) 94%,
    rgba(255,249,232,0) 100%
  );
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 9rpx 20rpx rgba(61,52,40,0.06);
}

.search-bar,
.filter-bar {
  left: 24rpx;
  right: 24rpx;
  width: auto;
  box-sizing: border-box;
  background: #fff9e8;
  border-left: 4rpx solid rgba(121,79,39,0.18);
  border-right: 4rpx solid rgba(121,79,39,0.18);
  box-shadow: none;
}

.search-bar {
  z-index: 140;
  top: 18rpx;
  padding: 18rpx 22rpx 12rpx;
  border-top: 4rpx solid rgba(121,79,39,0.18);
  border-bottom: 0;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.filter-bar {
  z-index: 139;
  top: 112rpx;
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  border-bottom: 4rpx solid rgba(121,79,39,0.18);
  border-top: 0;
  height: 82rpx;
  box-shadow: 0 8rpx 0 rgba(121,79,39,0.10), 0 16rpx 30rpx rgba(61,52,40,0.12);
}

.search-input {
  border: 3rpx solid rgba(159,146,125,0.30);
  box-shadow: inset 0 3rpx 0 rgba(121,79,39,0.04);
}

.filter-item {
  height: 82rpx;
  font-weight: 800;
}

.filter-item.active {
  color: var(--text-color);
}

.filter-item.active::after {
  bottom: 3rpx;
  height: 6rpx;
  background: var(--accent-yellow);
}

.inventory-list {
  position: relative;
  z-index: 1;
  padding-top: 226rpx;
  padding-left: 0;
  padding-right: 0;
}

.inventory-item-container,
.movable-area,
.movable-view,
.inventory-item {
  background:
    radial-gradient(circle, rgba(248,166,178,0.10) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    var(--card-bg);
  border-radius: var(--radius-lg);
}

.inventory-item-container {
  width: calc(100% - 48rpx);
  margin: 0 auto 18rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(121,79,39,0.14);
  box-shadow: 0 7rpx 0 rgba(121,79,39,0.10), 0 14rpx 24rpx rgba(61,52,40,0.12);
}

.empty-tip,
.load-more-tip,
.no-more-tip {
  width: calc(100% - 48rpx);
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

.item-image {
  border: 4rpx solid var(--card-bg-light);
  box-shadow: 0 4rpx 0 rgba(121,79,39,0.08);
}

.item-name {
  font-weight: 900;
}

.item-amount {
  color: var(--text-color);
  background: var(--accent-yellow);
  font-weight: 800;
}

.add-btn {
  background: var(--card-bg-light);
  border: 4rpx solid var(--primary-color);
  border-radius: 36rpx;
}

@media (max-width: 340px) {
  .item-date-summary { gap: 10rpx; }
  .date-label { display: none; }
  .item-image {
    width: 96rpx;
    height: 96rpx;
    min-width: 96rpx;
    margin-right: 14rpx;
  }
}
