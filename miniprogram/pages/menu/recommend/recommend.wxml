<view class="recommend-page">
  <view class="fixed-page-bg"></view>

  <view class="recommend-header">
    <view class="header-main">
      <view class="header-copy">
        <view class="recommend-title">冰箱推荐</view>
        <view class="recommend-subtitle">结合库存、临期食材和家人口味排序</view>
      </view>
      <view class="guide-tag">
        <mp-icon ext-class="guide-tag-icon" icon="shop" size="14" color="#0f8f85"></mp-icon>
        <text>库存优先</text>
      </view>
    </view>

    <view class="diner-control">
      <view class="band-heading">
        <view class="band-label">
          <mp-icon ext-class="band-label-icon" icon="me" size="16" color="#794f27"></mp-icon>
          <text class="band-title">一起用餐的家人</text>
        </view>
        <text class="band-count">已选 {{selectedDinerIds.length}}/{{members.length}}</text>
      </view>
      <scroll-view scroll-x="true" enhanced="true" enable-flex="true" show-scrollbar="false" class="diner-scroll">
        <view class="diner-row">
          <view wx:for="{{members}}" wx:key="userId" class="diner {{selectedDinerIds.indexOf(item.userId || item.id) >= 0 ? 'selected' : ''}}" data-id="{{item.userId || item.id}}" bindtap="toggleDiner">
            <view class="diner-avatar">
              <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" data-id="{{item.userId || item.id}}" data-index="{{index}}" binderror="onMemberImageError"></image>
              <mp-icon wx:else icon="me" size="14" color="#9f927d"></mp-icon>
            </view>
            <text class="diner-name">{{item.nickName || '家庭成员'}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <scroll-view class="recommend-scroll" scroll-y="true" enhanced="true" show-scrollbar="false" lower-threshold="120" bindscrolltolower="onScrollToLower">
    <view wx:if="{{loading && !recommendations.length}}" class="recommend-state island-surface">
      <island-loading></island-loading>
    </view>
    <view wx:elif="{{loadError}}" class="recommend-error island-surface">
      <view class="recommend-error-icon"><mp-icon icon="report-problem" size="26" color="#e05a5a"></mp-icon></view>
      <view class="recommend-error-title">推荐暂时没有加载成功</view>
      <view class="recommend-error-hint">{{loadError}}</view>
      <button bindtap="retryRecommendations">重新加载</button>
    </view>
    <view class="recommend-results" wx:elif="{{recommendations.length}}">
      <view class="list-heading">
        <view>
          <view class="list-title">优先推荐</view>
          <view class="list-hint">越靠前越适合当前冰箱和用餐成员</view>
        </view>
        <view class="list-count">{{total}} 道</view>
      </view>

      <view class="recommend-list">
        <view class="recommend-item" wx:for="{{recommendations}}" wx:key="id" wx:for-index="recommendIndex" bindtap="openDish" data-id="{{item.id}}">
          <view class="dish-media">
            <image referrerPolicy="no-referrer" class="dish-image" src="{{item.cachedImage || (item.images && item.images.length ? item.images[0] : '/images/default-dish.jpg')}}" mode="aspectFill" lazy-load="true" data-index="{{recommendIndex}}" data-id="{{item.id}}" binderror="onDishImageError"></image>
          </view>
          <view class="dish-content">
            <view class="dish-head">
              <text class="dish-name">{{item.name}}</text>
              <view class="coverage-badge">{{item.coverageRate}}% 有库存</view>
              <mp-icon ext-class="dish-arrow" icon="arrow" size="12" color="#9f927d"></mp-icon>
            </view>
            <view class="reason-row stock"><text class="reason-dot"></text><text class="reason">{{item.reasons.stock}}</text></view>
            <view class="reason-row expiring" wx:if="{{item.expiring.length}}"><text class="reason-dot"></text><text class="reason">{{item.reasons.expiring}}</text></view>
            <view class="reason-row warning" wx:if="{{item.warnings.length}}"><text class="reason-dot"></text><text class="reason">{{item.reasons.preference}}</text></view>
            <view class="missing" wx:if="{{item.missing.length}}">
              <text class="missing-label">还缺</text>
              <text class="missing-copy"><text wx:for="{{item.missing}}" wx:key="id" wx:for-item="ingredient">{{ingredient.name}}{{index < item.missing.length - 1 ? '、' : ''}}</text></text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="list-footnote">正在加载更多...</view>
      <view class="list-footnote">推荐结果仅供安排用餐参考，不会自动扣减库存</view>
    </view>
    <view wx:else class="recommend-empty island-surface">
      <island-empty title="当前家庭还没有可推荐的菜谱" hint="先添加菜谱和冰箱食材，再回来看看"></island-empty>
    </view>
  </scroll-view>
</view>
