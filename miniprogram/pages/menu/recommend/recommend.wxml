<view class="recommend-page">
  <view class="diner-band">
    <text class="band-title">用餐成员</text>
    <scroll-view scroll-x enable-flex show-scrollbar="false" class="diner-scroll">
      <view class="diner-row">
        <view wx:for="{{members}}" wx:key="userId" class="diner {{selectedDinerIds.indexOf(item.userId || item.id) >= 0 ? 'selected' : ''}}" data-id="{{item.userId || item.id}}" bindtap="toggleDiner">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <text>{{item.nickName || '家庭成员'}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <island-loading wx:if="{{loading}}"></island-loading>
  <view class="recommend-list" wx:elif="{{recommendations.length}}">
    <view class="recommend-item" wx:for="{{recommendations}}" wx:key="id" bindtap="openDish" data-id="{{item.id}}">
      <image class="dish-image" src="{{item.images[0] || '/images/default-dish.png'}}" mode="aspectFill"></image>
      <view class="dish-content">
        <view class="dish-head">
          <text class="dish-name">{{item.name}}</text>
          <text class="coverage">{{item.coverageRate}}%</text>
        </view>
        <text class="reason">{{item.reasons.stock}}</text>
        <text class="reason expiring" wx:if="{{item.expiring.length}}">{{item.reasons.expiring}}</text>
        <text class="reason warning" wx:if="{{item.warnings.length}}">{{item.reasons.preference}}</text>
        <view class="missing" wx:if="{{item.missing.length}}">
          <text>缺少：</text>
          <text wx:for="{{item.missing}}" wx:key="id" wx:for-item="ingredient">{{ingredient.name}}{{index < item.missing.length - 1 ? '、' : ''}}</text>
        </view>
      </view>
    </view>
  </view>
  <island-empty wx:else text="当前家庭还没有可推荐的菜谱"></island-empty>
</view>
