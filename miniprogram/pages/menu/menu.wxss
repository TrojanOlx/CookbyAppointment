.container {
  position: relative;
  height: 100vh;
  background:
    radial-gradient(circle at 18rpx 18rpx, var(--background-pattern-color) 0 9rpx, transparent 10rpx) 0 0/96rpx 96rpx,
    radial-gradient(circle at 54rpx 52rpx, rgba(255,255,255,0.10) 0 6rpx, transparent 7rpx) 0 0/80rpx 80rpx,
    linear-gradient(180deg, #b6dfc0 0%, #94cfb1 100%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

page {
  height: 100vh;
  overflow: hidden;
}

/* ── Tab 类型选择器 ── */
.type-selector {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border-bottom: 1rpx solid var(--border-color);
}

/* 固定"全部"项 */
.type-item.fixed {
  flex-shrink: 0;
  min-width: 104rpx;
  padding: 0 24rpx;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.type-item.fixed::before {
  content: '';
  position: absolute;
  right: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 1rpx;
  background: var(--border-color);
}
.type-item.fixed.active {
  color: var(--primary-color);
  font-weight: 700;
}

/* 可滚动区域 */
.scroll-types-wrap {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  position: relative;
}

.scroll-types {
  width: 100%;
  height: 88rpx;
  white-space: nowrap;
}

.type-selector-content {
  display: inline-flex;
  min-width: 100%;
  height: 88rpx;
  align-items: stretch;
  padding-right: 24rpx;
  white-space: nowrap;
}

/* 普通 type-item */
.type-item {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 88rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: color 0.2s;
}
.type-item:last-child {
  padding-right: 32rpx;
}
.type-item.active {
  color: var(--primary-color);
  font-weight: 700;
}
.type-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.scroll-hint {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 14rpx;
  box-sizing: border-box;
  background: linear-gradient(90deg, rgba(255,255,255,0), #fff 58%);
  pointer-events: none;
}

.scroll-hint-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--primary-color);
  border-right: 3rpx solid var(--primary-color);
  transform: rotate(45deg);
  opacity: 0.82;
  animation: scrollHint 1.4s ease-in-out infinite;
}

@keyframes scrollHint {
  0%, 100% {
    transform: translateX(-4rpx) rotate(45deg);
    opacity: 0.35;
  }
  50% {
    transform: translateX(4rpx) rotate(45deg);
    opacity: 0.9;
  }
}

/* ── 菜品列表 ── */
.dish-list {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  background: transparent;
  padding: 20rpx 24rpx;
  padding-top: calc(88rpx + 20rpx);
  height: calc(100vh - 88rpx);
}

.dish-item {
  display: flex;
  align-items: center;
  width: 100%;
  background: var(--card-bg);
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
  transition: opacity 0.15s;
}
.dish-item:active { opacity: 0.8; }

.dish-image {
  width: 152rpx;
  height: 152rpx;
  min-width: 152rpx;
  border-radius: var(--radius-sm);
  margin-right: 24rpx;
  background: var(--input-bg);
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  gap: 12rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dish-tag {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: var(--radius-full);
  line-height: 1.6;
}
.dish-tag.type {
  background: var(--primary-light);
  color: var(--primary-dark);
}
.dish-tag.spicy {
  background: var(--danger-light);
  color: var(--danger-color);
}

/* ── FAB ── */
.add-btn {
  position: fixed;
  right: 32rpx;
  width: 112rpx;
  height: 112rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-fab);
  z-index: 200;
  transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
}
.add-btn:active {
  transform: scale(0.93);
  box-shadow: 0 4rpx 12rpx rgba(76,175,80,0.22);
}

.add-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.add-icon::before,
.add-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 5rpx;
  background: #fff;
  border-radius: var(--radius-full);
  transform: translate(-50%, -50%);
}

.add-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

/* ── 空状态 ── */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
}
.empty-text {
  font-size: 30rpx;
  color: var(--text-light);
}

/* ── 加载状态 ── */
.loading-container {
  padding: 24rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.loading-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-light);
  font-size: 24rpx;
}
.loading-icon {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #E8E8E8;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.no-more-tip {
  color: var(--text-light);
  font-size: 24rpx;
  padding: 12rpx 0;
  text-align: center;
}

/* Animal Island native redesign */
.container {
  background:
    radial-gradient(circle at 18rpx 18rpx, var(--background-pattern-color) 0 9rpx, transparent 10rpx) 0 0/96rpx 96rpx,
    radial-gradient(circle at 54rpx 52rpx, rgba(255,255,255,0.10) 0 6rpx, transparent 7rpx) 0 0/80rpx 80rpx,
    linear-gradient(180deg, #b6dfc0 0%, #94cfb1 100%);
}

.type-selector {
  top: 24rpx;
  left: 28rpx;
  right: 28rpx;
  height: 84rpx;
  background: #fff9e8;
  border: 4rpx solid rgba(121,79,39,0.20);
  border-radius: var(--radius-full);
  box-shadow: 0 8rpx 0 rgba(121,79,39,0.12), 0 16rpx 30rpx rgba(61,52,40,0.14);
  overflow: hidden;
  z-index: 500;
}

.type-selector-fade {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 136rpx;
  z-index: 450;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    #fff9e8 0%,
    #fff9e8 82%,
    rgba(255,249,232,0.58) 94%,
    rgba(255,249,232,0) 100%
  );
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 9rpx 20rpx rgba(61,52,40,0.06);
}

.type-selector .type-item,
.type-selector .type-item.fixed,
.type-selector .scroll-types-wrap,
.type-selector .scroll-types,
.type-selector .type-selector-content,
.type-selector .scroll-hint {
  height: 84rpx;
}

.type-selector .type-item {
  justify-content: center;
}

.type-item.fixed::before {
  background: rgba(159,146,125,0.32);
}

.type-item.active {
  color: var(--text-color);
}

.type-item.active::after {
  bottom: 10rpx;
  height: 8rpx;
  background: var(--accent-yellow);
}

.scroll-hint {
  background: linear-gradient(90deg, rgba(255,249,232,0), #fff9e8 60%);
}

.dish-list {
  position: relative;
  z-index: 460;
  height: 100vh;
  padding-top: 138rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.dish-item {
  background: #fff9e8 !important;
  border: 4rpx solid rgba(121,79,39,0.14);
  border-radius: var(--radius-lg);
  box-shadow: 0 7rpx 0 rgba(121,79,39,0.10), 0 14rpx 24rpx rgba(61,52,40,0.12);
}

.dish-image {
  border: 4rpx solid var(--card-bg-light);
  box-shadow: 0 4rpx 0 rgba(121,79,39,0.08);
}

.dish-name {
  font-weight: 900;
}

.dish-tag.type {
  background: var(--accent-yellow);
  color: var(--text-color);
}

.add-btn {
  background: var(--card-bg-light);
  border: 4rpx solid var(--primary-color);
  border-radius: 36rpx;
  z-index: 700;
}

.add-icon::before,
.add-icon::after {
  background: var(--primary-color);
}

.empty-tip {
  margin: 0 8rpx;
  background: var(--card-bg);
  border: 2rpx solid rgba(159,146,125,0.36);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}
