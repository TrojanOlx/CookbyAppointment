page {
  height: 100vh;
  overflow: hidden;
}

.shopping-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  color: var(--text-color);
  background:
    radial-gradient(circle at 18rpx 18rpx, var(--background-pattern-color) 0 9rpx, transparent 10rpx) 0 0/96rpx 96rpx,
    radial-gradient(circle at 54rpx 52rpx, rgba(255,255,255,0.10) 0 6rpx, transparent 7rpx) 0 0/80rpx 80rpx,
    linear-gradient(180deg, #b6dfc0 0%, #94cfb1 100%);
}

.shopping-header {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 24rpx 32rpx 20rpx;
  background:
    radial-gradient(circle, rgba(247,205,103,0.12) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    rgba(247,243,223,0.96);
  border-bottom: 2rpx solid rgba(121,79,39,0.12);
  border-radius: 0 0 34rpx 34rpx;
  box-shadow: 0 8rpx 20rpx rgba(61,52,40,0.08);
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.header-copy {
  min-width: 0;
  flex: 0 1 260rpx;
}

.header-meta {
  display: flex;
  flex: 1;
  min-width: 0;
  max-width: 330rpx;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
}

.page-kicker {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  box-sizing: border-box;
  min-height: 38rpx;
  padding: 5rpx 13rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  border: 2rpx solid rgba(25,200,185,0.28);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.page-kicker-icon,
.family-chip-icon {
  flex-shrink: 0;
}

.page-title {
  color: var(--text-color);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 7rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.page-subtitle text { display: block; }

.family-chip {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 240rpx;
  min-height: 42rpx;
  margin-top: 10rpx;
  box-sizing: border-box;
  gap: 8rpx;
  padding: 0 13rpx;
  color: var(--text-color);
  font-size: 20rpx;
  font-weight: 800;
  background: var(--card-bg-light);
  border: 2rpx dashed rgba(25,200,185,0.46);
  border-radius: var(--radius-full);
  box-shadow: 0 4rpx 0 rgba(15,143,133,0.08);
}

.family-chip text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.header-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 64rpx;
  margin: 0;
  padding: 0 14rpx;
  box-sizing: border-box;
  color: var(--text-color);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
  border: 0;
  border-radius: var(--radius-full);
}

.header-action::after,
.modal-submit::after,
.stock-button::after,
.floating-add::after {
  border: 0;
}

.header-action-icon {
  margin-right: 8rpx;
}

.button-icon { margin-right: 7rpx; }

.sync-action {
  background: #fffdf4;
  border: 2rpx dashed var(--border-color);
  box-shadow: 0 4rpx 0 rgba(121,79,39,0.08);
}

.header-action:active,
.modal-submit:active,
.stock-button:active {
  transform: translateY(3rpx);
}

.shopping-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  box-sizing: border-box;
  padding: 28rpx 32rpx 0;
}

.fab-scroll-spacer {
  width: 100%;
  height: calc(164rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  color: #a0443d;
  background: var(--danger-light);
  border: 2rpx solid rgba(224,90,90,0.24);
  border-radius: var(--radius-md);
  font-size: 23rpx;
  line-height: 1.45;
}

.inline-error text {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
}

.inline-error button {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  color: var(--danger-color);
  background: #fff9e8;
  border: 0;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.notice-card,
.summary-card,
.list-card {
  box-sizing: border-box;
  margin-bottom: 22rpx;
  background:
    radial-gradient(circle, rgba(248,166,178,0.11) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    var(--card-bg);
  border: 2rpx solid rgba(159,146,125,0.36);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.notice-card {
  display: flex;
  align-items: center;
  padding: 32rpx 26rpx;
}

.notice-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  color: var(--primary-dark);
  font-size: 42rpx;
  background: var(--primary-light);
  border-radius: 24rpx;
}

.notice-copy {
  min-width: 0;
  flex: 1;
}

.notice-title {
  color: var(--text-color);
  font-size: 29rpx;
  font-weight: 900;
}

.notice-subtitle {
  margin-top: 6rpx;
  color: var(--text-light);
  font-size: 24rpx;
  line-height: 1.5;
}

.summary-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 190rpx;
  padding: 28rpx 28rpx 26rpx;
  overflow: hidden;
  background:
    radial-gradient(circle, rgba(25,200,185,0.12) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    #e6f9f6;
}

.summary-copy {
  min-width: 0;
  flex: 1;
  align-self: flex-start;
}

.summary-eyebrow {
  color: var(--primary-dark);
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.summary-title {
  max-width: 250rpx;
  margin-top: 8rpx;
  color: var(--text-color);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.summary-stats {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.summary-figure {
  min-width: 86rpx;
  text-align: center;
}

.summary-figure--warm .summary-number {
  color: #d68330;
}

.summary-number {
  color: var(--primary-dark);
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-label {
  margin-top: 9rpx;
  color: var(--text-secondary);
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
}

.summary-divider {
  width: 2rpx;
  height: 66rpx;
  margin: 0 12rpx;
  background: rgba(25,200,185,0.24);
}

.summary-ornament {
  position: absolute;
  right: 18rpx;
  bottom: 12rpx;
  width: 62rpx;
  height: 62rpx;
  opacity: 0.25;
  transform: rotate(-10deg);
}

.tab-strip {
  display: flex;
  align-items: center;
  margin: 0 6rpx 20rpx;
  border-bottom: 2rpx solid rgba(121,79,39,0.12);
}

.tab {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 68rpx;
  margin-right: 36rpx;
  color: var(--text-light);
  font-size: 28rpx;
  font-weight: 800;
}

.tab--active {
  color: var(--text-color);
}

.tab--active::after {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  left: 0;
  height: 6rpx;
  content: '';
  background: var(--primary-color);
  border-radius: var(--radius-full);
}

.tab-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 34rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  color: var(--primary-dark);
  font-size: 20rpx;
  background: var(--primary-light);
  border-radius: var(--radius-full);
}

.list-card {
  padding: 26rpx 22rpx 8rpx;
}

.list-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 4rpx 14rpx;
}

.heading-copy {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  gap: 12rpx;
}

.heading-ribbon {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  flex-shrink: 0;
  padding: 4rpx 18rpx;
  color: #fff9e8;
  font-size: 25rpx;
  font-weight: 900;
  background: var(--primary-color);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 0 var(--primary-dark);
}

.heading-ribbon--yellow {
  color: var(--text-color);
  background: var(--accent-yellow);
  box-shadow: 0 4rpx 0 #dba90e;
}

.heading-hint {
  min-width: 0;
  overflow: hidden;
  color: var(--text-light);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.heading-count {
  flex-shrink: 0;
  color: var(--primary-dark);
  font-size: 22rpx;
  font-weight: 900;
}

.heading-count--warm {
  color: #d68330;
}

.loading-state {
  padding: 70rpx 0;
  color: var(--text-light);
  font-size: 26rpx;
  text-align: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58rpx 18rpx 72rpx;
  text-align: center;
}

.empty-state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  color: var(--accent-orange);
  font-size: 60rpx;
  background: #fff4d8;
  border-radius: 38rpx;
}

.empty-state-title {
  margin-top: 18rpx;
  color: var(--text-color);
  font-size: 30rpx;
  font-weight: 900;
}

.empty-state-subtitle {
  max-width: 480rpx;
  margin-top: 8rpx;
  color: var(--text-light);
  font-size: 24rpx;
  line-height: 1.6;
}

.shopping-item {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  padding: 18rpx 4rpx;
  border-top: 2rpx solid rgba(121,79,39,0.10);
}

.shopping-item:first-of-type {
  border-top: 0;
}

.shopping-item--stocked {
  opacity: 0.62;
}

.item-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin: 0 18rpx 0 0;
  color: transparent;
  background: #fffdf4;
  border: 3rpx solid var(--border-color);
  border-radius: 50%;
}

.item-check--purchased {
  color: var(--text-light);
}

.item-check--selected {
  color: #fff9e8;
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.item-content {
  min-width: 0;
  flex: 1;
}

.item-main-row,
.item-meta-row,
.item-bottom-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.item-main-row {
  justify-content: space-between;
  gap: 16rpx;
  min-height: 42rpx;
}

.item-name {
  min-width: 0;
  overflow: hidden;
  color: var(--text-color);
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-quantity {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 58rpx;
  min-height: 40rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  color: var(--primary-dark);
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
  background: var(--primary-light);
  border: 2rpx solid rgba(25,200,185,0.22);
  border-radius: var(--radius-full);
}

.item-meta-row {
  margin-top: 7rpx;
  gap: 12rpx;
}

.item-source {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  color: #4f8b1e;
  font-size: 20rpx;
  font-weight: 800;
  background: var(--success-light);
  border-radius: var(--radius-full);
}

.item-source--purchased {
  color: #d68330;
  background: #fff1dc;
}

.item-note {
  min-width: 0;
  overflow: hidden;
  color: var(--text-light);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-bottom-row {
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 10rpx;
}

.assignee-control {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 72%;
  min-height: 44rpx;
  padding: 3rpx 12rpx 3rpx 5rpx;
  box-sizing: border-box;
  color: var(--text-secondary);
  font-size: 21rpx;
  background: #fffdf4;
  border: 2rpx solid rgba(159,146,125,0.24);
  border-radius: var(--radius-full);
}

.assignee-control text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.assignee-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-right: 7rpx;
  color: var(--primary-dark);
  font-size: 19rpx;
  font-weight: 900;
  background: #d9f0d7;
  border-radius: 50%;
}

.assignee-arrow {
  flex-shrink: 0;
  margin-left: 5rpx;
  color: var(--text-light);
  font-size: 28rpx;
}

.item-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  color: var(--danger-color);
  background: var(--danger-light);
  border: 2rpx solid rgba(224,90,90,0.18);
  border-radius: 50%;
}

.item-delete:active,
.assignee-control:active {
  transform: translateY(2rpx);
  opacity: 0.78;
}

.stock-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 94rpx;
  padding: 12rpx 16rpx 12rpx 26rpx;
  box-sizing: border-box;
  background: rgba(247,243,223,0.97);
  border: 2rpx solid rgba(159,146,125,0.40);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-lg);
}

.stock-copy {
  min-width: 0;
  color: var(--text-secondary);
  font-size: 23rpx;
  font-weight: 800;
}

.stock-count {
  margin-right: 5rpx;
  color: var(--primary-dark);
  font-size: 32rpx;
  font-weight: 900;
}

.stock-button {
  flex-shrink: 0;
  height: 68rpx;
  margin: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
  color: #fff9e8;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 68rpx;
  background: var(--primary-color);
  border-radius: var(--radius-full);
  box-shadow: 0 5rpx 0 var(--primary-dark);
}

.list-footnote {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 12rpx 38rpx;
  color: var(--text-light);
  font-size: 21rpx;
  text-align: center;
}

.floating-add {
  position: fixed;
  right: 32rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  box-sizing: border-box;
  color: var(--primary-dark);
  background: var(--card-bg-light);
  border: 4rpx solid var(--primary-color);
  border-radius: 36rpx;
  box-shadow: var(--shadow-fab);
}

.floating-add:active {
  transform: translateY(3rpx) scale(0.98);
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(61,52,40,0.42);
}

.modal-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 30rpx 26rpx 26rpx;
  background:
    radial-gradient(circle, rgba(248,166,178,0.09) 2rpx, transparent 3rpx) 0 0/42rpx 42rpx,
    var(--card-bg);
  border: 2rpx solid rgba(255,255,255,0.55);
  border-radius: 34rpx 34rpx 26rpx 26rpx;
  box-shadow: var(--shadow-lg);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.modal-title {
  color: var(--text-color);
  font-size: 34rpx;
  font-weight: 900;
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx !important;
  min-width: 52rpx !important;
  max-width: 52rpx !important;
  height: 52rpx !important;
  min-height: 52rpx;
  max-height: 52rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  line-height: 52rpx;
  background: rgba(121,79,39,0.08);
  border: 0;
  border-radius: 50%;
  white-space: nowrap;
}

.modal-close::after,
.inline-error button::after { border: 0; }

.modal-close mp-icon {
  display: block;
  flex: 0 0 auto;
}

.form-label {
  margin: 16rpx 0 9rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 800;
}

.form-label text {
  color: var(--danger-color);
}

.form-input {
  width: 100%;
  height: 78rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  color: var(--text-color);
  font-size: 28rpx;
  background: var(--input-bg);
  border: 3rpx solid var(--border-color);
  border-radius: var(--radius-sm);
}

.form-input:focus {
  border-color: var(--primary-color);
}

.form-inline {
  display: flex;
  gap: 16rpx;
}

.form-half {
  min-width: 0;
  flex: 1;
}

.sync-intro {
  padding: 18rpx 20rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
  background: #fff4d8;
  border: 2rpx solid rgba(247,205,103,0.34);
  border-radius: var(--radius-sm);
}

.modal-submit {
  width: 100%;
  height: 82rpx;
  flex-shrink: 0;
  margin: 26rpx 0 0;
  box-sizing: border-box;
  color: #fff9e8;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 82rpx;
  background: var(--primary-color);
  border: 0;
  border-radius: var(--radius-full);
  box-shadow: 0 6rpx 0 var(--primary-dark);
}

.modal-submit[disabled] {
  opacity: 0.56;
}

@media (max-height: 680px) {
  .shopping-header {
    padding-top: 18rpx;
    padding-bottom: 16rpx;
  }

  .page-title {
    font-size: 38rpx;
  }

  .page-subtitle {
    margin-top: 4rpx;
    font-size: 23rpx;
  }

  .header-actions {
    margin-top: 16rpx;
  }

  .header-action {
    height: 62rpx;
    line-height: 62rpx;
  }

  .summary-card {
    min-height: 166rpx;
    padding-top: 22rpx;
    padding-bottom: 22rpx;
  }

  .modal-card {
    padding-top: 22rpx;
    padding-bottom: 20rpx;
  }

  .form-input {
    height: 70rpx;
  }

  .modal-submit {
    height: 74rpx;
    line-height: 74rpx;
    margin-top: 20rpx;
  }
}
