.rate-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stars {
  display: flex;
  justify-content: center;
}

.star {
  margin: 0 10rpx;
  transition: transform var(--motion-state) var(--ease-out);
  display: flex;
  align-items: center;
  justify-content: center;
}

.star.active {
  transform: scale(1.1);
}

.star-icon {
  font-size: 60rpx;
  line-height: 1;
  color: var(--accent-yellow);
  text-shadow: 0 3rpx 0 rgba(121,79,39,0.12);
}

.rate-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--warning-color);
  font-weight: 800;
}

@media (prefers-reduced-motion: reduce) {
  .star {
    transition: none;
  }
}
