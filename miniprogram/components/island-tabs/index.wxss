.island-tabs {
  display: flex;
  gap: 12rpx;
  padding: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  background: rgba(255,249,232,0.72);
  border: 2rpx solid rgba(159,146,125,0.36);
  border-radius: var(--radius-full);
}

.island-tabs__item {
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 10rpx 26rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 800;
  border-radius: var(--radius-full);
}

.island-tabs__item.is-active {
  color: #fff9e8;
  background: var(--primary-color);
  box-shadow: 0 5rpx 0 var(--primary-dark);
}
